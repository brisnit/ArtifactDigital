{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/weeks-not-months",
      "destination": "/how-we-work",
      "statusCode": 301
    },
    {
      "source": "/services/product-digital-strategy",
      "destination": "/services/digital-strategy",
      "statusCode": 301
    },
    {
      "source": "/services/ai-interactive-experiences",
      "destination": "/services/ai-experience-design",
      "statusCode": 301
    },
    {
      "source": "/services/digital-products-ux",
      "destination": "/services/product-design",
      "statusCode": 301
    }
  ]
}
