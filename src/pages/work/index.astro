---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import WorkCard from '../../components/WorkCard.astro';
import { SITE, orgNode, breadcrumb } from '../../data/site';
import { caseTier, sortWork, TIER_LABEL } from '../../lib/proof';

// The rest of the site makes the argument; this page proves it. Order and tiers
// both come from src/lib/proof.ts, so the page can't quietly promote prior-agency
// work or a concept above what it is.
const projects = sortWork(await getCollection('work'));
const built = projects.filter((p) => !p.data.priorRole);
const [lead, ...moreBuilt] = built;
const teamWork = projects.filter((p) => caseTier(p) === 'team');
const founderWork = projects.filter((p) => caseTier(p) === 'founder');

// What the work draws on. Kept short: the cards carry the argument.
const INGREDIENTS = [
  { title: 'Product thinking', body: 'Deciding what should exist, and what shouldn’t.' },
  { title: 'Business understanding', body: 'How the work actually flows: approvals, handoffs, data, money.' },
  { title: 'UX', body: 'Software people can use without being trained on it.' },
  { title: 'Visual craft', body: 'Interfaces that feel considered, not generated.' },
  { title: 'Engineering', body: 'Data models, payments, permissions and production code.' },
  { title: 'Complex-system experience', body: 'Years inside large organizations and the ecosystems they run.' },
  { title: 'AI-assisted execution', body: 'More research, prototyping and testing than team size alone allows.' },
];

const itemList = {
  '@type': 'ItemList',
  '@id': `${SITE.url}/work#list`,
  name: 'Artifact Digital case studies',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: `${SITE.url}/${p.id}`,
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    itemList,
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Work', path: '/work' },
    ]),
  ],
};
---
<BaseLayout
  title="Our Work · Websites, Apps & Platforms · Artifact Digital"
  description="Websites, web apps and mobile apps Artifact Digital has designed and built, labelled by where each one stands — plus the enterprise work our founder and team led before Artifact."
  canonical="/work"
  bodyClass="case-page work-index"
  jsonLd={jsonLd}
>
  <section class="case-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Work' }]} />
      <span class="eyebrow reveal"><span class="eyebrow-dot"></span>Work</span>
      <h1 class="case-title">
        <span class="reveal-line"><span>Sites, apps</span></span>
        <span class="reveal-line italic"><span>and the thinking behind them.</span></span>
      </h1>
      <p class="case-lede reveal">
        Artifact is a newer company, built by people who spent years designing and
        delivering digital platforms for major organizations. This page shows both: what
        we’ve built since, labelled by where each one actually stands, and the experience
        behind it, labelled by who did the work.
      </p>
    </div>
  </section>

  <!-- Built at Artifact -->
  <section class="section work" aria-labelledby="work-built-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Built at Artifact</span>
        <h2 class="section-heading reveal-line" id="work-built-heading"><span>What we’ve built</span></h2>
      </header>
      <p class="work-attribution reveal">
        Websites, apps and products this company designed and built — for clients, and for
        ourselves. Some are live and in daily use, some are pre-launch, one is a working
        prototype. Each card says which.
      </p>
      <div class="project-grid">
        {lead && <WorkCard entry={lead} headingLevel="h3" showTier wide priority />}
        {moreBuilt.map((p) => <WorkCard entry={p} headingLevel="h3" showTier wide={false} />)}
      </div>
    </div>
  </section>

  <!-- What the work draws on -->
  <section class="section service-section work-draws">
    <div class="container service-section__grid">
      <div class="service-section__head">
        <h2 class="service-section__heading reveal-line"><span>Why we can build it</span></h2>
      </div>
      <div class="service-prose service-section__body">
        <p class="reveal">
          A site or an app is only as good as the understanding behind it. None of this work
          came from engineering alone. It came from the same combination, every time:
        </p>
        <ul class="work-draws__list">
          {INGREDIENTS.map((i) => (
            <li class="reveal"><strong>{i.title}.</strong> {i.body}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- The experience behind Artifact, attributed -->
  <section class="section work work--career" aria-labelledby="work-before-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Before Artifact</span>
        <h2 class="section-heading reveal-line" id="work-before-heading"><span>The experience behind it</span></h2>
      </header>
      <p class="work-attribution reveal">
        Before Artifact, our founder and team designed and delivered digital products,
        platforms and ecosystems for major organizations, in director and senior roles at
        other agencies. Those engagements belonged to those agencies and their clients,
        not to Artifact. We show them because that experience is what we build on, and we
        label them so nobody mistakes one for the other. Client names, branding and
        proprietary assets have been removed.
      </p>

      <div class="work-group">
        <h3 class="work-group__label reveal">{TIER_LABEL.team}</h3>
        <p class="work-group__note reveal">
          Work Britt Midgette and people who now work on Artifact projects delivered
          together at a previous agency.
        </p>
        <div class="project-grid project-grid--pairs">
          {teamWork.map((p) => <WorkCard entry={p} headingLevel="h4" showTier />)}
        </div>
      </div>

      <div class="work-group">
        <h3 class="work-group__label reveal">{TIER_LABEL.founder}</h3>
        <p class="work-group__note reveal">
          Led by founder Britt Midgette in director roles, before he started Artifact.
        </p>
        <div class="project-grid project-grid--trio">
          {founderWork.map((p) => <WorkCard entry={p} headingLevel="h4" showTier />)}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Have something you want to build?"
    sub="Tell us what you’re trying to create, fix or grow. We’ll help you figure out the smartest way to get it live."
    primary={{ label: 'Tell Us About Your Project', href: '/contact?intent=build' }}
    secondary={{ label: 'See How We Work', href: '/how-we-work' }}
  />
</BaseLayout>
