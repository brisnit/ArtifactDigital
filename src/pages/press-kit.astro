---
import fs from 'node:fs';
import nodePath from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, orgNode, breadcrumb } from '../data/site';
import { AUTHORS } from '../data/authors';
import { caseTier, tierText, sortWork, CONCEPTS, TIER_LABEL } from '../lib/proof';
import { responsive } from '../lib/responsive';
import { imageSize } from '../lib/imageSize';

// Press kit and resource center. Every fact, product, person and asset here
// comes from data the rest of the site already publishes: the work collection,
// src/lib/proof.ts, src/data/authors.ts and public/brand_assets. Where the repo
// has no verified source, the page says less rather than inventing more.
const route = '/press-kit';

const work = sortWork(await getCollection('work'));
function byId(id: string) {
  const entry = work.find((w) => w.id === id);
  if (!entry) throw new Error(`press-kit: unknown case "${id}"`);
  return entry;
}
function featureOf(id: string) {
  const f = byId(id).data.feature;
  if (!f?.image) throw new Error(`press-kit: case "${id}" has no feature image`);
  return f as { image: string; alt: string; caption: string };
}

// --- Hero: real product screens, each carrying its real status ---------------
const heroShots = await Promise.all(
  ['case-benchbot', 'case-senior-living-ministry', 'case-dropq'].map(async (id) => {
    const f = featureOf(id);
    return { entry: byId(id), src: f.image, alt: f.alt, img: await responsive(f.image) };
  })
);

// --- Company facts (verified: site.ts and the Capabilities procurement data) --
const FACTS: { label: string; value: string; href?: string }[] = [
  { label: 'Company', value: 'Artifact Digital LLC' },
  { label: 'Category', value: 'Digital Product & Technology' },
  { label: 'Capabilities', value: 'Strategy / UX / UI / Software / AI' },
  { label: 'Founded', value: SITE.foundingDate },
  { label: 'Location', value: 'San Diego, California' },
  { label: 'Website', value: SITE.url.replace(/^https?:\/\//, ''), href: SITE.url },
];

// --- Capabilities catalog: each links to the page that goes deeper ------------
const CATALOG = [
  { title: 'Custom Software & SaaS', body: 'Custom platforms designed around unique business operations.', href: '/services/bespoke-saas' },
  { title: 'AI & Intelligent Systems', body: 'Agents, predictive experiences, intelligent workflows, and AI-enabled products.', href: '/services/ai-experience-design' },
  { title: 'Digital Products', body: 'Customer-facing and internal applications from concept through production.', href: '/services/web-apps' },
  { title: 'UX & Product Design', body: 'Research, strategy, information architecture, interaction design, and visual design.', href: '/services/product-design' },
  { title: 'Websites & Digital Ecosystems', body: 'High-performance websites and interconnected digital experiences.', href: '/services/websites' },
  { title: 'Design Systems', body: 'Scalable systems connecting brand, product, design, and development.', href: '/services/design-system-maturity-model' },
  { title: 'Digital Modernization', body: 'Transforming legacy platforms, workflows, and experiences into modern systems.', href: '/services/experience-audits' },
  { title: 'Rapid Prototyping', body: 'Moving ideas into working software quickly enough to learn from the real experience.', href: '/how-we-work#method' },
];

// --- Selected work: prior work, anonymized exactly as its case study is -------
const selected = await Promise.all(
  ['case-it-training', 'case-global-nutrition', 'case-major-electronics', 'case-weather-intelligence'].map(async (id) => {
    const entry = byId(id);
    const f = featureOf(id);
    return { entry, tier: caseTier(entry), src: f.image, alt: f.alt, img: await responsive(f.image) };
  })
);

// --- Product lab: Artifact-built products, plus concepts ---------------------
// One-line purposes restate what src/data/build.ts already publishes.
const PURPOSE: Record<string, string> = {
  'case-dropq': 'Timed product drops, payments and pickup for independent sellers.',
  'case-benchbot': 'Audits a website against real competitors and turns the findings into prioritized, trackable work.',
  'case-senior-living-ministry':
    'A Scripture-first daily formation app for senior-living residents, with an admin portal staff run without a developer.',
};
const built = work.filter((w) => !w.data.priorRole);
const products = await Promise.all(
  built.map(async (entry) => {
    const f = featureOf(entry.id);
    return {
      name: entry.data.title,
      category: entry.data.category,
      purpose: PURPOSE[entry.id] ?? entry.data.card.blurb,
      chip: tierText(entry),
      tier: caseTier(entry) as string,
      href: `/${entry.id}`,
      linkLabel: 'Read the case study',
      liveUrl: entry.data.liveUrl,
      src: f.image,
      alt: f.alt,
      img: await responsive(f.image),
    };
  })
);
const concepts = await Promise.all(
  CONCEPTS.map(async (c) => ({
    name: c.name,
    category: c.eyebrow,
    purpose: `${c.blurb.split('. ')[0].replace(/\.$/, '')}.`,
    chip: `${TIER_LABEL.concept} · ${c.status}`,
    tier: 'concept',
    href: c.href,
    linkLabel: 'Read the thinking',
    liveUrl: undefined as string | undefined,
    src: c.image,
    alt: c.imageAlt,
    img: await responsive(c.image),
  }))
);
const lab = [...products, ...concepts];

// --- Live products: only the public URLs the case studies already verify -----
const DEMO_MEDIA: Record<string, { src: string; alt: string; cta: string }> = {
  'case-benchbot': {
    src: '/brand_assets/cases/benchbot-story.webp',
    alt: "BenchBot's landing page on a laptop and a phone",
    cta: 'Launch Demo',
  },
  'case-dropq': {
    src: '/brand_assets/cases/dropq-og.webp',
    alt: 'DropQ on three phones: a seller storefront, drop creation and a confirmed order',
    cta: 'Visit DropQ',
  },
};
const demos = await Promise.all(
  built
    .filter((e) => e.data.liveUrl && DEMO_MEDIA[e.id])
    .map(async (entry) => {
      const m = DEMO_MEDIA[entry.id];
      const url = entry.data.liveUrl as string;
      return {
        entry,
        url,
        host: url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
        chip: tierText(entry),
        tier: caseTier(entry) as string,
        ...m,
        img: await responsive(m.src),
      };
    })
);

// --- Leadership: current roles and portraits from src/data/authors.ts --------
// Bios are shortened from the published ones; they add no new claims.
const SHORT_BIO: Record<string, string> = {
  'Britt Midgette':
    "A multidisciplinary creative and digital product leader whose work spans design, technology, music, strategy and storytelling. Before founding Artifact, he led digital strategy and experience design in director roles at agencies, for organizations including Samsung, Levi's, Under Armour, LEGOLAND, CompTIA and SAG-AFTRA.",
  'Jonathan Smith':
    'Leads visual design, product thinking and AI-enabled creative workflows. He has led product and brand design for organizations including ServiceNow, Intuit, Qualcomm, Disney and Under Armour.',
  'Erik Parr':
    'Leads the architecture and engineering of intelligent digital products across agentic AI, spatial computing and interactive systems, built for reliability, observability and trust.',
  'Andrew Statezny':
    'Leads partnerships and business development, drawing on more than 35 years of work with leaders and organizations across all 50 states and 73 countries.',
};
const leaders = Object.keys(SHORT_BIO).map((name) => ({ ...AUTHORS[name], short: SHORT_BIO[name] }));

// --- Team experience: names already published in the founder and team bios ---
// Plain type, never logos. None of these are presented as Artifact clients.
const EXPERIENCE = [
  'Samsung', "Levi's", 'Under Armour', 'Philips', 'Bose', "L'Oréal", 'MAC Cosmetics', 'LEGOLAND',
  'CompTIA', 'ADM', 'Shoe Carnival', 'SAG-AFTRA', 'ServiceNow', 'Intuit', 'Qualcomm', 'Disney',
];

// --- Media & brand assets: only files that exist in public/brand_assets ------
async function asset(src: string, label: string, tile: 'dark' | 'light' | 'photo' = 'photo') {
  const file = nodePath.join(process.cwd(), 'public', src.replace(/^\//, ''));
  const size = await imageSize(src);
  const kb = Math.max(1, Math.round(fs.statSync(file).size / 1024));
  const ext = nodePath.extname(src).slice(1).toUpperCase();
  return { src: encodeURI(src), label, tile, ext, meta: `${ext} · ${size ? `${size.width}×${size.height}` : ''} · ${kb} KB` };
}
const ASSET_GROUPS = [
  {
    title: 'Logos & brand marks',
    note: 'Raster files as used on this site. Use the white lockup on dark backgrounds and the black wordmark on light ones.',
    items: await Promise.all([
      asset('/brand_assets/A_Logo_DT3.png', 'Logo lockup · for dark backgrounds', 'dark'),
      asset('/brand_assets/A_Logo_Mobile3.png', 'Logo mark', 'dark'),
      asset('/brand_assets/Logo_25.png', 'Wordmark · for light backgrounds', 'light'),
      asset('/brand_assets/Brand Guidelines.png', 'Brand guidelines sheet', 'light'),
    ]),
  },
  {
    title: 'Leadership portraits',
    note: 'Approved headshots of Artifact leadership.',
    items: await Promise.all([
      asset('/brand_assets/Britt_Midgette.webp', 'Britt Midgette · full portrait'),
      ...leaders.map((l) => asset(l.avatar as string, `${l.name} · headshot`)),
    ]),
  },
  {
    title: 'Product screenshots',
    note: 'Screens from Artifact-built products. Figures shown are sample or demo data.',
    items: await Promise.all([
      asset('/brand_assets/cases/dropq-feature.webp', 'DropQ · vendor and buyer flow'),
      asset('/brand_assets/cases/benchbot-feature.webp', 'BenchBot · mobile screens'),
      asset('/brand_assets/cases/benchbot-story.webp', 'BenchBot · desktop and mobile'),
      asset('/brand_assets/cases/ministry-feature.webp', 'Senior-Living Ministry · admin portal'),
    ]),
  },
];
const COLORS = [
  { name: 'Ink', hex: '#111111', light: false },
  { name: 'Stone', hex: '#F4F4F4', light: true },
  { name: 'Steel', hex: '#6B6B6B', light: false },
  { name: 'Blush', hex: '#FFC9C4', light: true },
  { name: 'Accent', hex: '#FF2D72', light: false },
];

// --- Latest from Artifact: there is no external press yet, so Insights ------
const latest = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const latestMedia = new Map<string, Awaited<ReturnType<typeof responsive>>>();
for (const p of latest) if (p.data.heroImage) latestMedia.set(p.data.heroImage, await responsive(p.data.heroImage));
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const JUMP = [
  { href: '#company', label: 'Company' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#selected-work', label: 'Selected work' },
  { href: '#product-lab', label: 'Product lab' },
  { href: '#leadership', label: 'Leadership' },
  { href: '#assets', label: 'Brand assets' },
  { href: '#latest', label: 'Latest' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}${route}#page`,
      url: `${SITE.url}${route}`,
      name: 'Press Kit & Product Showcase',
      description:
        'Company facts, capabilities, products, leadership, brand assets and latest thinking from Artifact Digital.',
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
    },
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Press Kit', path: route },
    ]),
  ],
};
---
<BaseLayout
  title="Press Kit & Product Showcase | Artifact Digital"
  description="The Artifact Digital press kit: a strategy, design, software and AI company. Company facts, capabilities, products and live demos, leadership, brand assets and our latest thinking."
  canonical={route}
  ogImageAlt="Artifact Digital press kit"
  bodyClass="case-page press-kit"
  preloadImage="/brand_assets/cases/dropq-feature-960w.webp"
  jsonLd={jsonLd}
>
  <!-- 1. HERO -->
  <section class="pk-hero" aria-labelledby="pk-title">
    <div class="container pk-hero__grid">
      <div class="pk-hero__copy">
        <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Press Kit' }]} />
        <span class="eyebrow reveal"><span class="eyebrow-dot"></span>Artifact Digital / Press Kit</span>
        <h1 class="case-title pk-hero__title" id="pk-title">
          <span class="reveal-line"><span>We build what</span></span>
          <span class="reveal-line italic"><span>doesn’t exist yet.</span></span>
        </h1>
        <p class="pk-hero__lede reveal">
          Artifact Digital is a strategy, design, and technology company creating bespoke
          software, intelligent digital products, and modern experiences built around the way
          organizations actually work.
        </p>
        <div class="hero-actions pk-hero__actions reveal">
          <Button href="/work" label="Explore our work" variant="primary" />
          <Button href="#company" label="Company information" variant="secondary" />
        </div>
      </div>

      <div class="pk-stack reveal" role="group" aria-label="Screens from software Artifact built">
        {heroShots.map((s, i) => (
          <figure class="pk-frame">
            <img
              src={s.src}
              alt={s.alt}
              width={s.img.width}
              height={s.img.height}
              srcset={s.img.srcset}
              sizes="(max-width: 900px) 90vw, 520px"
              loading={i === heroShots.length - 1 ? 'eager' : 'lazy'}
              fetchpriority={i === heroShots.length - 1 ? 'high' : undefined}
              decoding="async"
            />
            <figcaption class="pk-frame__label">
              <span>{s.entry.data.title}</span>
              {s.entry.data.status && <span class="pk-frame__status">{s.entry.data.status}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <nav class="pk-jump" aria-label="On this page">
    <div class="container">
      <ul class="pk-jump__list">
        {JUMP.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- 2. COMPANY OVERVIEW -->
  <section class="section pk-section" id="company" aria-labelledby="pk-company-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>01 — Company</span>
        <h2 class="section-heading reveal-line" id="pk-company-heading"><span>Software built around your business.</span></h2>
      </header>
      <div class="pk-overview">
        <div class="pk-overview__copy">
          <p class="pk-overview__lead reveal">
            Most organizations are forced to adapt their business to their software. Artifact
            reverses that relationship.
          </p>
          <p class="reveal">
            We combine strategy, experience design, visual design, engineering, and AI to create
            digital products and platforms tailored to the people and organizations that use them.
          </p>
        </div>
        <dl class="pk-facts">
          {FACTS.map((f) => (
            <div class="pk-fact reveal-card">
              <dt>{f.label}</dt>
              <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 3. CAPABILITIES CATALOG -->
  <section class="section pk-section pk-section--stone" id="capabilities" aria-labelledby="pk-cap-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>02 — Capabilities</span>
        <h2 class="section-heading reveal-line" id="pk-cap-heading"><span>What we make</span></h2>
      </header>
      <ul class="pk-cat">
        {CATALOG.map((c, i) => (
          <li class="reveal-card">
            <a class="pk-cat__item" href={c.href}>
              <span class="pk-cat__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="pk-cat__title">{c.title}</h3>
              <p class="pk-cat__body">{c.body}</p>
              <span class="pk-cat__more" aria-hidden="true">Explore →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. SELECTED WORK -->
  <section class="section pk-section" id="selected-work" aria-labelledby="pk-work-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>03 — Selected work</span>
        <h2 class="section-heading reveal-line" id="pk-work-heading"><span>Experience at scale</span></h2>
      </header>
      <p class="pk-intro reveal">
        Before Artifact, our founder and team led digital platforms and ecosystems for major
        organizations, in director and senior roles at other agencies. These engagements belonged
        to those agencies and their clients, so each is labelled that way and the clients stay
        anonymized, as they are across this site.
      </p>
      <ol class="pk-work">
        {selected.map((s, i) => (
          <li class="pk-work__row">
            <a class="pk-work__media reveal-card" href={`/${s.entry.id}`} tabindex="-1" aria-hidden="true">
              <img
                src={s.src}
                alt=""
                width={s.img.width}
                height={s.img.height}
                srcset={s.img.srcset}
                sizes="(max-width: 860px) 100vw, 60vw"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="pk-work__text reveal">
              <span class="pk-work__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class={`tier-chip tier-chip--${s.tier}`}>{TIER_LABEL[s.tier]}</span>
              <p class="pk-work__eyebrow">{s.entry.data.card.eyebrow} · {s.entry.data.year}</p>
              <h3 class="pk-work__title">{s.entry.data.title}</h3>
              <p class="pk-work__blurb">{s.entry.data.card.blurb}</p>
              <ul class="project-card__tags">{s.entry.data.card.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="pk-link" href={`/${s.entry.id}`}>Read the case study<span class="sr-only">: {s.entry.data.title}</span> →</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="pk-more reveal"><a class="pk-link" href="/work">All work, including what Artifact has built →</a></p>
    </div>
  </section>

  <!-- 5 + 6. PRODUCT LAB AND LIVE DEMOS -->
  <section class="section pk-section pk-dark" id="product-lab" aria-labelledby="pk-lab-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>04 — Product lab</span>
        <h2 class="section-heading reveal-line" id="pk-lab-heading"><span>Ideas become software.</span></h2>
      </header>
      <p class="pk-intro reveal">
        Artifact doesn’t only build for clients. We design and build our own products and
        prototypes, which is where much of how we work gets tested first. Each one is labelled with
        where it actually stands.
      </p>

      <ul class="pk-lab">
        {lab.map((p) => (
          <li class="pk-product reveal-card">
            <div class="pk-product__media">
              <img
                src={p.src}
                alt={p.alt}
                width={p.img.width}
                height={p.img.height}
                srcset={p.img.srcset}
                sizes="(max-width: 900px) 100vw, 600px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="pk-product__body">
              <span class={`tier-chip tier-chip--${p.tier}`}>{p.chip}</span>
              <h3 class="pk-product__name">{p.name}</h3>
              <p class="pk-product__cat">{p.category}</p>
              <p class="pk-product__purpose">{p.purpose}</p>
              <div class="pk-product__actions">
                <a class="pk-link pk-link--light" href={p.href}>{p.linkLabel}<span class="sr-only">: {p.name}</span> →</a>
                {p.liveUrl && (
                  <a class="pk-link pk-link--light" href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                    Open live product<span class="sr-only">: {p.name} (opens in a new tab)</span> ↗
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>

      {demos.length > 0 && (
        <div class="pk-demos" id="demos">
          <h3 class="pk-demos__title reveal">Try it live</h3>
          <p class="pk-demos__note reveal">
            Public products you can use today. Each opens in a new tab.
          </p>
          {demos.map((d) => (
            <article class="pk-demo reveal-card" aria-labelledby={`demo-${d.entry.id}`}>
              <div class="pk-browser">
                <div class="pk-browser__bar" aria-hidden="true">
                  <span class="pk-browser__dots"><i></i><i></i><i></i></span>
                  <span class="pk-browser__url">{d.host}</span>
                </div>
                <img
                  src={d.src}
                  alt={d.alt}
                  width={d.img.width}
                  height={d.img.height}
                  srcset={d.img.srcset}
                  sizes="(max-width: 900px) 100vw, 760px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="pk-demo__text">
                <span class={`tier-chip tier-chip--${d.tier}`}>{d.chip}</span>
                <h4 class="pk-demo__name" id={`demo-${d.entry.id}`}>{d.entry.data.title}</h4>
                <p class="pk-demo__desc">{d.entry.data.card.blurb}</p>
                <a class="btn btn-primary" href={d.url} target="_blank" rel="noopener noreferrer">
                  {d.cta} <span aria-hidden="true">↗</span>
                  <span class="sr-only">(opens {d.host} in a new tab)</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 7. LEADERSHIP -->
  <section class="section pk-section" id="leadership" aria-labelledby="pk-lead-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>05 — Leadership</span>
        <h2 class="section-heading reveal-line" id="pk-lead-heading"><span>The people behind it</span></h2>
      </header>
      <ul class="pk-leaders">
        {leaders.map((l) => (
          <li class="pk-leader reveal-card">
            <img class="pk-leader__photo" src={l.avatar} alt={`${l.name}, ${l.jobTitle}`} width="240" height="240" loading="lazy" decoding="async" />
            <h3 class="pk-leader__name">{l.name}</h3>
            <p class="pk-leader__role">{l.jobTitle}</p>
            <p class="pk-leader__bio">{l.short}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. EXPERIENCE STRIP -->
  <section class="pk-experience" aria-labelledby="pk-exp-heading">
    <div class="container">
      <h2 class="pk-experience__label" id="pk-exp-heading">Selected team experience</h2>
      <ul class="pk-experience__list">
        {EXPERIENCE.map((n) => <li>{n}</li>)}
      </ul>
      <p class="pk-experience__note">
        Organizations our founder and team worked with in previous roles, before or outside
        Artifact Digital. This is not a list of Artifact Digital clients.
      </p>
    </div>
  </section>

  <!-- 9. MEDIA & BRAND ASSETS -->
  <section class="section pk-section" id="assets" aria-labelledby="pk-assets-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>06 — Media &amp; brand assets</span>
        <h2 class="section-heading reveal-line" id="pk-assets-heading"><span>Approved materials</span></h2>
      </header>

      {ASSET_GROUPS.map((g) => (
        <div class="pk-assets__group">
          <h3 class="pk-assets__title reveal">{g.title}</h3>
          <p class="pk-assets__note reveal">{g.note}</p>
          <ul class="pk-assets">
            {g.items.map((a) => (
              <li class="pk-asset reveal-card">
                <div class={`pk-asset__preview pk-asset__preview--${a.tile}`}>
                  <img src={a.src} alt="" loading="lazy" decoding="async" />
                </div>
                <p class="pk-asset__label">{a.label}</p>
