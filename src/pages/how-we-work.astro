---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import { SITE, orgNode, breadcrumb, CTA } from '../data/site';
import { METHOD, MODEL_COMPARISON } from '../data/method';

// How we work, in five plain steps. /weeks-not-months 301-redirects here
// (vercel.json), so its article links still land.
const path = '/how-we-work';
const url = `${SITE.url}${path}`;

// Resolved from the collection so a renamed article fails the build instead
// of shipping a dead link.
const READING = [
  'agency-of-the-future-smaller-faster-senior',
  'why-we-prototype-before-we-promise',
  'design-and-build-with-ai-dont-ship-slop',
];
const insights = await getCollection('insights');
const reading = READING.map((id) => {
  const article = insights.find((a) => a.id === id);
  if (!article) throw new Error(`how-we-work: missing article "${id}"`);
  return article;
});

// One array feeds both the visible answers and the FAQ schema.
const FAQ = [
  {
    q: 'How long does a project take?',
    a: 'A focused website is usually weeks rather than months. An app depends on what it has to do, and we’ll give you a real range once we understand it. What doesn’t change is that you see actual screens early instead of waiting until the end for a reveal.',
  },
  {
    q: 'What does it cost?',
    a: 'It depends on scope, and we’ll tell you an honest range early — before you’ve spent much time with us. We’re not the cheapest option and we don’t compete with template sites; what you’re paying for is senior people doing the work rather than selling it.',
  },
  {
    q: 'Who actually does the work?',
    a: 'The senior people you meet. There’s no account layer between you and the team, and no handoff to a junior group after the pitch.',
  },
  {
    q: 'Where does AI fit in?',
    a: 'Everywhere it makes us faster: research, exploring directions, code, tests, documentation. It doesn’t decide what to build, how it should work, or whether it’s good enough. Those stay with experienced people who are accountable for the result.',
  },
  {
    q: 'What if we don’t know what we need yet?',
    a: 'That’s a normal starting point. The first stage exists to work that out, and it regularly ends with us recommending something smaller than the client expected — or an off-the-shelf tool instead of anything custom.',
  },
  {
    q: 'Do you work with our existing team or platform?',
    a: 'Yes. We can run a project end to end, or bring strategy, design and front-end work to a team that already has engineers. If you already have a platform that fits, we build on it rather than selling you a migration.',
  },
  {
    q: 'What happens after launch?',
    a: 'Launch is where the useful information starts. Some clients take it from there; others keep us on for hosting, support and steady improvement. Both are fine, and you can change your mind later.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      name: 'How We Work · Artifact Digital',
      url,
      description:
        'Understand, Design, Build, Launch, Grow — how Artifact Digital runs a website or app project, and where AI fits in.',
      about: { '@id': `${SITE.url}/#organization` },
      isPartOf: { '@id': `${SITE.url}/#website` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'How We Work', path },
    ]),
  ],
};
---
<BaseLayout
  title="How We Work · Five Steps, No Mystery · Artifact Digital"
  description="Understand, Design, Build, Launch, Grow. How Artifact Digital runs a website or app project — what happens at each stage, what you see when, and where AI fits in."
  canonical={path}
  ogImage="/brand_assets/insights/Landing.webp"
  bodyClass="case-page wnm-page"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="wnm-hero">
    <div class="container wnm-hero__grid">
      <div class="wnm-hero__copy">
        <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'How We Work' }]} />
        <span class="eyebrow reveal"><span class="eyebrow-dot"></span>How we work</span>
        <h1 class="wnm-hero__title">
          <span class="reveal-line"><span>Five steps,</span></span>
          <span class="reveal-line italic"><span>no mystery.</span></span>
        </h1>
        <p class="wnm-hero__lede reveal">
          Understand, Design, Build, Launch, Grow. No proprietary methodology, no
          twelve-page process diagram — just the order the work actually happens in, run by
          senior people who do it themselves.
        </p>
        <div class="hero-actions reveal">
          <Button href={CTA.primary.href} label={CTA.primary.label} variant="primary" />
          <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
        </div>
      </div>
      <div class="wnm-hero__media reveal-card">
        <img src="/brand_assets/insights/Landing.webp" alt="Interlocking paths finding their way forward" width="634" height="473" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- THE METHOD -->
  <section class="section wnm-phases" id="method">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>The five steps</span>
        <h2 class="section-heading reveal-line"><span>What happens, in order</span></h2>
      </header>
      <p class="home-lede reveal">
        The same five stages on every project, whether it’s a marketing site or a platform.
        What changes is how long each one takes.
      </p>
      <ol class="hww-stages">
        {METHOD.map((m, i) => (
          <li class="hww-stage reveal">
            <span class="hww-stage__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="hww-stage__main">
              <h3 class="hww-stage__title">{m.title}</h3>
              <p class="hww-stage__body">{m.body}</p>
            </div>
            <div class="hww-stage__leverage">
              <span class="hww-stage__label">Where AI helps</span>
              <p>{m.leverage}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="wnm-note reveal">
        Every project is different. This is the shape, not a contract. What doesn’t change
        is the order: understand it before you design it, design it before you build it.
      </p>
    </div>
  </section>

  <!-- WHY THIS WORKS AT OUR SIZE -->
  <section class="section model" aria-labelledby="effort-heading">
    <div class="container model-grid">
      <div class="model-copy">
        <span class="section-tag reveal"><span class="tag-dot"></span>Why a small team can do this</span>
        <h2 class="model-heading reveal" id="effort-heading">Big-agency thinking. <em>Small senior team.</em></h2>
        <p class="model-lede reveal">
          For most of the history of this work, doing more meant hiring more: more
          specialists, more coordination, more handoffs between the person who understood
          the problem and the person building the answer.
        </p>
        <p class="model-lede reveal">
          AI changed that arithmetic. A small, experienced team can now explore more
          directions, build faster and test more than that structure allowed — which is why
          you can get senior people on a project that wouldn’t have justified them before.
        </p>
      </div>
      <div class="model-table-wrap reveal">
        <table class="model-table">
          <caption class="sr-only">How the traditional agency model and the Artifact model compare</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Aspect</span></th><th scope="col">Traditional agency</th><th scope="col">Artifact</th></tr>
          </thead>
          <tbody>
            {MODEL_COMPARISON.map(([label, before, after]) => (
              <tr><th scope="row">{label}</th><td data-label="Traditional">{before}</td><td data-label="Artifact">{after}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- AI WITHOUT THE SLOP -->
  <section class="section service-section">
    <div class="container service-section__grid">
      <div class="service-section__head">
        <h2 class="service-section__heading reveal-line"><span>AI made building faster. It didn’t make good thinking automatic.</span></h2>
      </div>
      <div class="service-prose service-section__body">
        <p class="reveal">
          Anyone can prompt a website into existence now. What that doesn’t give you is the
          strategy behind it, the structure, the content, the accessibility, or the judgment
          about which shortcut becomes next year’s problem.
        </p>
        <p class="reveal">
          So we use AI for speed and reach — more research read, more directions explored,
          more of the code and tests written — and keep every decision that matters with
          people who have made those decisions before, many times.
        </p>
        <p class="reveal">
          <a class="home-more__link" href="/why-artifact#ai-without-the-slop">Our position on AI<span aria-hidden="true"> →</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAST IS NOT THE POINT -->
  <section class="section service-section">
    <div class="container service-section__grid">
      <div class="service-section__head">
        <h2 class="service-section__heading reveal-line"><span>Fast is not the point</span></h2>
      </div>
      <div class="service-prose service-section__body">
        <p class="reveal">
          Speed is easy to sell and easy to misuse. If you’re heading somewhere wrong,
          arriving twice as fast doesn’t help.
        </p>
        <p class="reveal">
          What actually matters is how quickly you find out. Most digital projects don’t
          fail because the build was bad; they fail because a decision was made before
          anyone had enough information, and by the time reality arrived, changing course
          had become too expensive.
        </p>
        <p class="reveal">
          So we optimize for learning early. Real screens in the first weeks, something
          working soon after, and honest conversations while being wrong is still cheap.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section service-lists">
    <div class="container service-lists__grid">
      <div>
        <h2 class="service-list__title reveal-line"><span>What you get</span></h2>
        <ul class="ticklist">
          <li class="reveal">Senior people who understand the business before proposing anything</li>
          <li class="reveal">Real screens early, not a reveal at the end</li>
          <li class="reveal">A site or app that’s fast, accessible and built to be maintained</li>
          <li class="reveal">The technical groundwork for search and AI discovery at launch</li>
          <li class="reveal">Your accounts, your code, your content — no lock-in</li>
          <li class="reveal">An honest recommendation, including when you should spend less</li>
        </ul>
      </div>
      <div>
        <h2 class="service-list__title reveal-line"><span>Who it’s for</span></h2>
        <ul class="ticklist">
          <li class="reveal">Founders turning an idea into something real</li>
          <li class="reveal">Businesses whose site no longer matches how good they are</li>
          <li class="reveal">Growing companies outgrowing the tools they started on</li>
          <li class="reveal">Organizations that need senior help without hiring an agency</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section service-faq">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Questions</span>
        <h2 class="section-heading reveal-line"><span>The honest answers</span></h2>
      </header>
      <dl class="faq-list">
        {FAQ.map((f) => (
          <div class="faq-item reveal">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FURTHER READING -->
  <section class="section related-services">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Further reading</span>
        <h2 class="section-heading reveal-line"><span>The thinking behind it</span></h2>
      </header>
      <div class="service-link-grid">
        {reading.map((a) => (
          <a class="service-link-card reveal-card" href={`/insights/${a.id}`}>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
            <span class="service-link-card__more">Read it →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section wnm-cta" aria-labelledby="wnm-cta-heading">
    <div class="container wnm-cta__inner">
      <h2 class="wnm-cta__heading" id="wnm-cta-heading">
        Have something you want to build?
      </h2>
      <p class="wnm-cta__sub">
        Tell us what you’re trying to create, fix or grow. We’ll help you figure out the
        smartest way to get it live.
      </p>
      <div class="hero-actions">
        <Button href={CTA.primary.href} label="Tell Us About Your Project" variant="primary" />
        <Button href="/services" label="See What We Do" variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
