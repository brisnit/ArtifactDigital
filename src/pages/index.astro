---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE, orgNode, websiteNode, CTA } from '../data/site';
import { testimonials } from '../data/testimonials';
import { BUILD_CLUSTERS, buildPath } from '../data/build';
import { DOORS } from '../data/doors';
import { METHOD } from '../data/method';
import { sortWork } from '../lib/proof';

// The homepage sells into a moment, not a capability list: your business has
// outgrown the way you're running it. Recognition first, then three obvious
// doors, then proof. Everything deeper is reached from one of those.

const allWork = sortWork(await getCollection('work'));
const proofIds = ['case-left-coast-printing-pros', 'case-tiny-crm', 'case-ithink', 'case-phoenix-rising', 'case-benchbot', 'case-dropq'];
const proof = proofIds
  .map((id) => allWork.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const live = testimonials.filter((t) => t.approved);

// Section 2: situations a buyer recognizes as their own.
const MOMENTS = [
  'Your website no longer reflects the company you’ve become.',
  'A spreadsheet quietly turned into a mission-critical system.',
  'Customers have to call because your software can’t do something.',
  'Your team copies the same information between five tools.',
  'You have a product idea and nobody internally can build it.',
  'Everyone keeps saying “AI” and nobody knows where it would help.',
];

// Section 5: what we decide before anything gets built.
const DECISIONS = ['fixed', 'redesigned', 'automated', 'connected', 'built', 'or left alone'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    orgNode,
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE.url}/#service`,
      name: SITE.name,
      url: `${SITE.url}/`,
      image: `${SITE.url}${SITE.ogImage}`,
      parentOrganization: { '@id': `${SITE.url}/#organization` },
      areaServed: 'United States',
      slogan: 'Your business has outgrown the way you’re running it.',
      description: SITE.description,
      knowsAbout: [
        'Website redesign',
        'Web app development',
        'Custom software',
        'AI implementation',
        'Workflow automation',
        'Ecommerce',
        'UX design',
        'SEO',
        'AI search optimization',
        'Accessibility',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'How we help',
        itemListElement: DOORS.map((d) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: d.label, description: d.summary, url: `${SITE.url}${d.href}` },
          description: d.priceRange,
        })),
      },
    },
    websiteNode,
  ],
};
---
<BaseLayout
  title="Artifact Digital · Software, Websites & AI for Growing Companies"
  description="Your business has outgrown the way you're running it. Artifact Digital helps growing companies fix broken digital experiences, build better software and use AI where it actually makes sense."
  canonical="/"
  preloadImage="/brand_assets/hero-reel.webp"
  jsonLd={jsonLd}
>
  <!-- 01 / HERO -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-meta">
          <span class="eyebrow"><span class="eyebrow-dot"></span>Digital studio · San Diego</span>
        </div>

        <h1 class="hero-heading hero-heading--long">
          <span class="line"><span class="reveal-word"><span>Your business has</span></span></span>
          <span class="line"><span class="reveal-word"><span>outgrown the way</span></span></span>
          <span class="line italic"><span class="reveal-word"><span>you’re running it.</span></span></span>
        </h1>

        <div class="hero-foot">
          <p class="hero-lede">
            We design and build the websites, applications and AI systems that help growing
            companies get to the next stage.
          </p>
          <div class="hero-actions">
            <Button href={CTA.problem.href} label={CTA.problem.label} variant="primary" />
            <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
          </div>
          <ul class="hero-offer" aria-label="What we work on">
            {BUILD_CLUSTERS.map((c) => <li><a href={buildPath(c.id)}>{c.label}</a></li>)}
          </ul>
        </div>
      </div>

      <div class="hero-visual">
        <video
          class="hero-video"
          data-src="/brand_assets/hero-reel.mp4"
          data-src-mobile="/brand_assets/hero-reel-mobile.mp4"
          poster="/brand_assets/hero-reel.webp"
          muted loop playsinline autoplay preload="metadata"
          aria-label="Sketching wireframes on paper, notes on a wall, and a storefront on a phone"
        ></video>
      </div>
    </div>
  </section>

  <!-- 02 / THE MOMENT -->
  <section class="section moment" id="the-moment" aria-labelledby="moment-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>The moment</span>
        <h2 class="section-heading reveal-line" id="moment-heading"><span>“There has to be a better way to do this.”</span></h2>
      </header>
      <ul class="moment-list">
        {MOMENTS.map((m) => <li class="reveal">{m}</li>)}
      </ul>
      <p class="moment-turn reveal">That’s where we come in.</p>
    </div>
  </section>

  <!-- 03 / THREE DOORS -->
  <section class="section doors" id="how-we-help" aria-labelledby="doors-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>How we help</span>
        <h2 class="section-heading reveal-line" id="doors-heading"><span>Where do you need help?</span></h2>
      </header>
      <ul class="door-grid">
        {DOORS.map((d) => (
          <li class="reveal-card">
            <a class="door-card" href={d.href}>
              <span class="door-card__num" aria-hidden="true">{d.num}</span>
              <h3 class="door-card__title">{d.label}</h3>
              <p class="door-card__price">{d.priceRange}</p>
              <p class="door-card__body">{d.summary}</p>
              <span class="door-card__more" aria-hidden="true">{d.cta.label} →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="home-more reveal">
        <a class="home-more__link" href="/pricing">How pricing works<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <!-- 04 / PROOF -->
  <section class="section work" id="work">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Proof</span>
        <h2 class="section-heading reveal-line"><span>We don’t just talk about it. We build it.</span></h2>
      </header>

      <div class="project-grid project-grid--trio">
        {proof.slice(0, 6).map((p) => <WorkCard entry={p} showTier showProblem />)}
      </div>
      <p class="home-more reveal"><a class="home-more__link" href="/work">See all work<span aria-hidden="true"> →</span></a></p>

      {live.length > 0 && (
        <div class="testimonial-grid">
          {live.map((t) => (
            <figure class="testimonial reveal-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="testimonial__role">{t.name}</span>
                <span class="testimonial__sector">{t.role}</span>
                {t.context && <span class="testimonial__context">{t.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 05 / HOW WE THINK -->
  <section class="section model" id="how-we-think" aria-labelledby="think-heading">
    <div class="container model-grid">
      <div class="model-copy">
        <span class="section-tag reveal"><span class="tag-dot"></span>How we think</span>
        <h2 class="model-heading reveal" id="think-heading">Technology isn’t <em>the strategy.</em></h2>
        <p class="model-lede reveal">
          We start with the business — how the work actually flows, where it costs you, what
          customers run into. Only then does anything get decided about software.
        </p>
        <p class="model-lede reveal">
          Most of the value is in knowing which move to make. Plenty of companies have been
          sold a rebuild they didn’t need, or an AI project with nowhere useful to land.
        </p>
      </div>
      <div class="model-pillars reveal">
        <p class="decide-label">Then we work out what should be</p>
        <ul class="decide-list">
          {DECISIONS.map((d) => <li>{d}</li>)}
        </ul>
        <p class="decide-note">
          “Left alone” is a real answer, and it’s the one nobody selling you software wants
          to give.
        </p>
      </div>
    </div>
  </section>

  <!-- 06 / AI -->
  <section class="section slop" id="ai" aria-labelledby="slop-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>AI without the slop</span>
        <h2 class="slop-heading reveal-line" id="slop-heading">
          <span>AI can make the work faster.</span>
          <span class="italic">It can’t tell you what’s worth building.</span>
        </h2>
      </header>
      <div class="slop-grid">
        <div class="slop-copy">
          <p class="reveal">
            We use AI hard, every day, and we build AI into the systems we make for clients —
            inside the workflow, doing real work, rather than a chatbot bolted onto a corner
            of the screen.
          </p>
          <p class="reveal">
            What it doesn’t do is decide what should exist. Anyone can generate a website
            now; that doesn’t make it the right one. The judgment is still the job.
          </p>
          <p class="reveal"><a class="home-more__link" href="/why-artifact#ai-without-the-slop">Our position on AI<span aria-hidden="true"> →</span></a></p>
        </div>
        <div class="slop-list-wrap reveal">
          <h3 class="slop-list__title">Still a human call</h3>
          <ul class="slop-list">
            <li>What the business actually needs</li>
            <li>What’s worth building, and what isn’t</li>
            <li>How the experience should work</li>
            <li>Brand, tone and design judgment</li>
            <li>Accessibility and the edge cases</li>
            <li>What to do first</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 / PROCESS -->
  <section class="section approach" id="process">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>How it goes</span>
        <h2 class="section-heading reveal-line"><span>Five steps, no mystery</span></h2>
      </header>
      <ol class="approach-grid approach-grid--five">
        {METHOD.map((m, i) => (
          <li class="approach-card reveal-card">
            <span class="approach-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </li>
        ))}
      </ol>
      <p class="approach-more reveal"><a href="/how-we-work">How we work, in full<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- 08 / AFTER LAUNCH -->
  <section class="section digital-team" id="after-launch" aria-labelledby="after-heading">
    <div class="container digital-team__grid">
      <div>
        <span class="section-tag reveal"><span class="tag-dot"></span>After launch</span>
        <h2 class="section-heading reveal-line" id="after-heading">
          <span>Launch isn’t</span>
          <span><em>the finish line.</em></span>
        </h2>
      </div>
      <div>
        <p class="digital-team__lede reveal">
          Most clients keep us on afterwards: hosting, analytics, search visibility, and a
          steady cycle of improvements as the business changes. Optional, priced separately,
          and easy to stop.
        </p>
        <ul class="ticklist">
          <li class="reveal">Hosting, monitoring, updates and security</li>
          <li class="reveal">Analytics, SEO and AI-search reporting</li>
          <li class="reveal">Improvements shipped in regular cycles</li>
          <li class="reveal">New functionality as the business grows</li>
        </ul>
        <p class="reveal" style="margin-top: 1.75rem;">
          <a class="home-more__link" href="/services/hosting-support">Hosting &amp; support<span aria-hidden="true"> →</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 09 / FINAL CTA -->
  <section class="section contact" id="contact">
    <div class="container contact-inner">
      <span class="section-tag reveal"><span class="tag-dot"></span>Start here</span>

      <h2 class="contact-heading">
        <span class="reveal-line"><span>What’s not working</span></span>
        <span class="reveal-line"><span><em>in your business?</em></span></span>
      </h2>
      <p class="contact-sub reveal">
        Tell us what’s slowing you down, what you’re trying to build, or what you suspect
        could be better. We’ll tell you what we’d do about it — including when the answer
        costs you nothing.
      </p>

      <div class="hero-actions reveal" style="margin: 2rem 0 2.5rem;">
        <Button href={CTA.problem.href} label={CTA.problem.label} variant="primary" />
        <Button href={CTA.pricing.href} label={CTA.pricing.label} variant="secondary" />
      </div>

      <a class="contact-email reveal" href="mailto:hello@artifactdigital.co">
        hello@artifactdigital.co
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M2 11h17M13 4l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="contact-grid">
        <div class="contact-block reveal">
          <span class="contact-block__label">Studio</span>
          <p>San Diego, CA<br />Working with teams worldwide</p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">New business</span>
          <p><a href="mailto:hello@artifactdigital.co">hello@artifactdigital.co</a></p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">Follow</span>
          <p><a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
