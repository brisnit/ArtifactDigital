---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE, orgNode, websiteNode, CTA } from '../data/site';
import { testimonials } from '../data/testimonials';
import { BUILD_CLUSTERS, buildPath } from '../data/build';
import { METHOD } from '../data/method';
import { caseTier, sortWork } from '../lib/proof';

// The homepage answers one question in the first five seconds: what do these
// people make? Websites and apps, and help finding you. Everything deeper —
// SaaS products, AI tools, portals — is discovered from there, never required
// to understand this page.

const allWork = sortWork(await getCollection('work'));
const artifactWork = allWork.filter((p) => !p.data.priorRole).slice(0, 3);
const careerWork = allWork.filter((p) => caseTier(p) === 'founder').slice(0, 3);

const live = testimonials.filter((t) => t.approved);

// The five product screens in the hero reel, with their real status. The
// caption follows this timeline, so the reel never implies more than is true.
const REEL = [
  { from: 0, name: 'Illustrative footage', status: 'Concept interfaces · not client or live products' },
];

// Section 2: what a visitor is here for, in their words.
const NEEDS = [
  {
    id: 'websites',
    label: 'A website',
    body: 'A site that explains what you do, earns trust and is easy to update.',
    examples: 'Business sites · Ecommerce · Content platforms',
  },
  {
    id: 'web-apps',
    label: 'A web app',
    body: 'A portal, dashboard, internal tool or software product people log into.',
    examples: 'Portals · Dashboards · SaaS · AI tools',
  },
  {
    id: 'mobile-apps',
    label: 'A mobile app',
    body: 'Something on the phone, designed for one hand and small moments.',
    examples: 'iOS & Android · Prototypes',
  },
  {
    id: 'seo-ai-search',
    label: 'To be found',
    body: 'Search and AI assistants sending the right people your way.',
    examples: 'SEO · AI search (GEO) · Analytics',
  },
];

// Section 5: the part AI genuinely doesn't do for you.
const NOT_AUTOMATIC = [
  'Knowing what the business actually needs',
  'Understanding the customer',
  'Deciding what goes where, and what to cut',
  'Making it work for everyone, including assistive technology',
  'Design judgment, and a brand that looks like you',
  'Knowing which shortcut becomes next year’s problem',
];

// Section 7 + 8: growth and support, in plain terms.
const GROWTH = [
  'Technical SEO: speed, structure, crawlability and the groundwork search needs',
  'AI search (GEO): being understood and accurately described by AI assistants',
  'Content built on the questions your buyers actually ask',
  'Structured data, so machines read your pages correctly',
  'Analytics that show what people do, not just how many arrived',
];
const SUPPORT = [
  'Hosting, domains, backups and monitoring, in accounts you own',
  'Updates and security, applied and tested',
  'Improvements shipped in small, regular cycles',
  'Search, analytics and reporting in plain language',
  'A senior contact who knows your business, for the decisions in between',
];

const serviceNode = {
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#service`,
  name: SITE.name,
  url: `${SITE.url}/`,
  image: `${SITE.url}${SITE.ogImage}`,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
  areaServed: 'Worldwide',
  slogan: 'We design, build and grow websites & apps.',
  description: SITE.description,
  knowsAbout: [
    'Web design',
    'Web development',
    'Web app development',
    'Mobile app development',
    'Ecommerce',
    'SEO',
    'AI search optimization',
    'UX design',
    'Accessibility',
    'Website hosting and support',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What we do',
    itemListElement: BUILD_CLUSTERS.map((c) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: c.label,
        description: c.summary,
        url: `${SITE.url}${buildPath(c.id)}`,
      },
    })),
  },
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [orgNode, serviceNode, websiteNode] };
---
<BaseLayout
  title="Web Design, Web Apps & Mobile Apps | Artifact Digital"
  description="Artifact Digital designs, builds and grows websites, web apps and mobile apps for founders and growing businesses — strategy, UX, design, development, hosting, SEO and AI search."
  canonical="/"
  preloadImage="/brand_assets/hero-cinematic.webp"
  jsonLd={jsonLd}
>
  <!-- 1. HERO -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-meta">
          <span class="eyebrow"><span class="eyebrow-dot"></span>Digital studio · Founders & growing businesses</span>
        </div>

        <h1 class="hero-heading hero-heading--long">
          <span class="line"><span class="reveal-word"><span>We design, build</span></span></span>
          <span class="line"><span class="reveal-word"><span>and grow websites</span></span></span>
          <span class="line italic"><span class="reveal-word"><span>&amp; apps.</span></span></span>
        </h1>

        <div class="hero-foot">
          <p class="hero-lede">
            Beautiful, accessible digital products for founders and growing businesses —
            from strategy and UX to development, hosting, SEO and AI search.
          </p>
          <div class="hero-actions">
            <Button href={CTA.primary.href} label={CTA.primary.label} variant="primary" />
            <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
          </div>
          <ul class="hero-offer" aria-label="What we do">
            {BUILD_CLUSTERS.map((c) => <li><a href={buildPath(c.id)}>{c.label}</a></li>)}
          </ul>
        </div>
      </div>

      <div class="hero-visual">
        <video
          class="hero-video"
          data-src="/brand_assets/hero-cinematic.mp4"
          data-src-mobile="/brand_assets/hero-cinematic-mobile.mp4"
          data-reel={JSON.stringify(REEL)}
          poster="/brand_assets/hero-cinematic.webp"
          muted loop playsinline autoplay preload="metadata"
          aria-label="Illustrative footage of software interfaces"
          aria-describedby="heroReelList"
        ></video>
        <p class="hero-reel-caption" aria-hidden="true">
          <span class="hero-reel-caption__name" data-reel-name>{REEL[0].name}</span>
          <span class="hero-reel-caption__status" data-reel-status>{REEL[0].status}</span>
        </p>
        <ul class="sr-only" id="heroReelList">
          {REEL.map((r) => <li>{r.name}: {r.status}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. WHAT DO YOU NEED? -->
  <section class="section needs" id="what-you-need" aria-labelledby="needs-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Where to start</span>
        <h2 class="section-heading reveal-line" id="needs-heading"><span>What do you need?</span></h2>
      </header>
      <ul class="need-grid">
        {NEEDS.map((n, i) => (
          <li class="reveal-card">
            <a class="need-card" href={buildPath(n.id)}>
              <span class="need-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="need-card__title">{n.label}</h3>
              <p class="need-card__body">{n.body}</p>
              <span class="need-card__examples">{n.examples}</span>
              <span class="need-card__more" aria-hidden="true">Start here →</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="need-wide reveal-card" href={buildPath('hosting-support')}>
        <span class="need-wide__copy">
          <strong>Already have a site or app?</strong> We host, maintain, improve and grow what
          you already run — the outside digital team for businesses that don’t have one.
        </span>
        <span class="need-wide__more" aria-hidden="true">Hosting &amp; support →</span>
      </a>
    </div>
  </section>

  <!-- 3. WHY ARTIFACT -->
  <section class="section model" id="why-artifact" aria-labelledby="why-heading">
    <div class="container model-grid">
      <div class="model-copy">
        <span class="section-tag reveal"><span class="tag-dot"></span>Why Artifact</span>
        <h2 class="model-heading reveal" id="why-heading">Big-agency thinking. <em>Small senior team.</em></h2>
        <p class="model-lede reveal">
          Our team has designed and built digital platforms, products and design systems for
          some of the largest organizations in the world. Artifact brings that level of
          thinking to founders and growing businesses — without the layers, the handoffs or
          the overhead that usually come with it.
        </p>
        <p class="model-lede reveal">
          You work directly with senior people. The ones who scope the work are the ones who
          do it.
        </p>
        <p class="reveal"><a class="home-more__link" href="/why-artifact">Why Artifact<span aria-hidden="true"> →</span></a></p>
      </div>
      <div class="model-pillars reveal">
        <ul class="why-list">
          <li><strong>Strategy first.</strong> We work out what you actually need before designing anything.</li>
          <li><strong>Accessible by default.</strong> Built to work for everyone, on every device, from the start.</li>
          <li><strong>AI without the slop.</strong> AI for speed, experienced people for judgment.</li>
          <li><strong>Senior team.</strong> No juniors learning on your budget, no account layer in between.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. WORK -->
  <section class="section work" id="work">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Work</span>
        <h2 class="section-heading reveal-line"><span>What we’ve built</span></h2>
      </header>

      <div class="project-grid project-grid--trio">
        {artifactWork.map((p) => <WorkCard entry={p} showTier />)}
      </div>

      {live.length > 0 && (
        <div class="testimonial-grid">
          {live.map((t) => (
            <figure class="testimonial reveal-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="testimonial__role">{t.name}</span>
                <span class="testimonial__sector">{t.role}</span>
                {t.context && <span class="testimonial__context">{t.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section work work--career" id="career-work">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Before Artifact</span>
        <h2 class="section-heading reveal-line"><span>Where the experience comes from</span></h2>
      </header>
      <p class="work-attribution reveal">
        Platforms our founder led in director roles at previous agencies, before Artifact
        existed. They were not Artifact engagements. Client names, branding and proprietary
        assets have been removed, while the thinking behind the work is described as it happened.
      </p>

      <div class="project-grid project-grid--trio">
        {careerWork.map((p) => <WorkCard entry={p} showTier />)}
      </div>
      <p class="home-more reveal"><a class="home-more__link" href="/work">See all work<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- 5. AI WITHOUT THE SLOP -->
  <section class="section slop" id="ai" aria-labelledby="slop-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>AI without the slop</span>
        <h2 class="slop-heading reveal-line" id="slop-heading">
          <span>AI made building faster.</span>
          <span class="italic">It didn’t make good thinking automatic.</span>
        </h2>
      </header>
      <div class="slop-grid">
        <div class="slop-copy">
          <p class="reveal">
            Anyone can prompt a website into existence now. That doesn’t mean it has the right
            strategy, structure, content, accessibility or technology behind it — and the
            difference shows up in whether it actually works.
          </p>
          <p class="reveal">
            We use AI aggressively, because it lets a small senior team do far more: explore
            more directions, build faster, test more, ship sooner. Then experienced people
            decide what’s right, which is the part that never became automatic.
          </p>
          <p class="slop-line reveal">AI helps us move faster. Experience tells us where to go.</p>
          <p class="reveal"><a class="home-more__link" href="/why-artifact#ai-without-the-slop">Our position on AI<span aria-hidden="true"> →</span></a></p>
        </div>
        <div class="slop-list-wrap reveal">
          <h3 class="slop-list__title">What AI still doesn’t do for you</h3>
          <ul class="slop-list">
            {NOT_AUTOMATIC.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. HOW WE WORK -->
  <section class="section approach" id="approach">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>How we work</span>
        <h2 class="section-heading reveal-line"><span>Five steps, no mystery</span></h2>
      </header>

      <ol class="approach-grid approach-grid--five">
        {METHOD.map((m, i) => (
          <li class="approach-card reveal-card">
            <span class="approach-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </li>
        ))}
      </ol>
      <p class="approach-more reveal"><a href="/how-we-work">How we work, in full<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- 7. SEO + GEO -->
  <section class="speed-module" id="growth" aria-labelledby="growth-heading">
    <div class="container speed-module__inner">
      <div class="speed-module__copy">
        <span class="section-tag"><span class="tag-dot"></span>SEO + AI search</span>
        <h2 class="speed-module__heading" id="growth-heading">
          Build something great. <em>Then make sure people can find it.</em>
        </h2>
        <p class="speed-module__lede">
          People still search on Google, and a growing number now ask ChatGPT, Gemini or
          Perplexity instead. Both work the same way underneath: they reward sites that are
          fast, clearly structured and genuinely useful. That’s the work.
        </p>
        <ul class="speed-module__points">
          {GROWTH.map((g) => <li>{g}</li>)}
        </ul>
        <p class="growth-note">
          What we won’t do is promise you a position. Nobody controls those results — we
          improve what’s actually in your control, and show you what changed.
        </p>
        <div class="speed-module__actions">
          <Button href="/services/seo-ai-search" label="SEO + AI search" variant="primary" />
          <Button href={CTA.audit.href} label={CTA.audit.label} variant="secondary" />
        </div>
      </div>

      <div class="speed-module__media">
        <img
          class="speed-module__img speed-module__img--main"
          src="/brand_assets/insights/bespoke-module.webp"
          srcset="/brand_assets/insights/bespoke-module-480w.webp 480w, /brand_assets/insights/bespoke-module.webp 634w"
          sizes="(max-width: 900px) 100vw, 560px"
          alt="Modular blocks locking together into a single system"
          width="634" height="473" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 8. YOUR DIGITAL TEAM -->
  <section class="section digital-team" id="support" aria-labelledby="support-heading">
    <div class="container digital-team__grid">
      <div>
        <span class="section-tag reveal"><span class="tag-dot"></span>Hosting &amp; support</span>
        <h2 class="section-heading reveal-line" id="support-heading">
          <span>You don’t need an internal</span>
          <span>digital team. <em>We can be yours.</em></span>
        </h2>
      </div>
      <div>
        <p class="digital-team__lede reveal">
          Most digital work is sold as a project with an end date, and then nothing happens
          for two years. We stay on where it helps, so what we built keeps getting better
          instead of quietly falling behind.
        </p>
        <ul class="ticklist">
          {SUPPORT.map((s) => <li class="reveal">{s}</li>)}
        </ul>
        <p class="reveal" style="margin-top: 1.75rem;">
          <a class="home-more__link" href="/services/hosting-support">Hosting &amp; support<span aria-hidden="true"> →</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 9. FINAL CTA -->
  <section class="section contact" id="contact">
    <div class="container contact-inner">
      <span class="section-tag reveal"><span class="tag-dot"></span>Start a project</span>

      <h2 class="contact-heading">
        <span class="reveal-line"><span>Have something</span></span>
        <span class="reveal-line"><span><em>you want to build?</em></span></span>
      </h2>
      <p class="contact-sub reveal">
        Tell us what you’re trying to create, fix or grow. We’ll help you figure out the
        smartest way to get it live — including when the simplest option is the right one.
      </p>

      <div class="hero-actions reveal" style="margin: 2rem 0 2.5rem;">
        <Button href={CTA.primary.href} label="Tell Us About Your Project" variant="primary" />
        <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
      </div>

      <a class="contact-email reveal" href="mailto:hello@artifactdigital.co">
        hello@artifactdigital.co
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M2 11h17M13 4l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="contact-grid">
        <div class="contact-block reveal">
          <span class="contact-block__label">Studio</span>
          <p>San Diego, CA<br />Working with teams worldwide</p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">New business</span>
          <p><a href="mailto:hello@artifactdigital.co">hello@artifactdigital.co</a></p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">Follow</span>
          <p><a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
