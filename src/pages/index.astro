---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE, orgNode, websiteNode, CTA } from '../data/site';
import { testimonials } from '../data/testimonials';
import { BUILD_CLUSTERS, buildPath } from '../data/build';
import { METHOD, MODEL_COMPARISON } from '../data/method';

const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// Two proofs, kept apart: software Artifact built, and platforms Britt led
// before Artifact existed. The homepage career tier shows the three that are
// software platforms; every case stays on /work.
const artifactWork = allWork.filter((p) => !p.data.priorRole);
// Listed in the order of the numbers printed on their cards.
const CAREER_PLATFORMS = ['case-it-training', 'case-major-clothing', 'case-weather-intelligence'];
const careerWork = CAREER_PLATFORMS.map((id) => allWork.find((p) => p.id === id)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p)
);

// Quotes about software lead the proof; other client quotes sit beneath it.
const live = testimonials.filter((t) => t.approved);
const softwareQuotes = live.filter((t) => t.kind === 'software');
const otherQuotes = live.filter((t) => t.kind !== 'software');

// Every product in the hero reel, with its real ownership and status. The
// caption under the video follows this timeline, so the reel never implies
// more than is true. Times match the scene cuts in the rendered video.
const REEL = [
  { from: 0, name: 'DropQ', status: 'Built by Artifact · Live · demo storefront shown' },
  { from: 5.4, name: 'Predictive Learning Platform', status: 'Artifact concept · In development' },
  { from: 10.4, name: 'Senior-Living Ministry', status: 'Built by Artifact · Prototype' },
  { from: 15.4, name: 'BenchBot', status: "Artifact's own product · Pre-launch" },
];

const MODEL_ROWS = MODEL_COMPARISON;

// What bespoke software is for — not results Artifact has measured. No
// outcome figures appear until there are real ones to cite.
const OUTCOMES = [
  { title: 'Efficiency', body: 'Fewer workarounds, less manual effort, and teams back on the work they were hired to do.' },
  { title: 'Revenue', body: 'New ways to earn from what your business already does well.' },
  { title: 'Intelligence', body: "A clearer view of what's happening across the business, and what's likely next." },
  { title: 'Differentiation', body: "Your way of doing things, built into software competitors can't buy." },
  { title: 'Customer experience', body: 'Service that is consistent, responsive and unmistakably yours.' },
  { title: 'Ownership', body: 'A business asset you control, extend and improve on your own terms.' },
];

const serviceNode = {
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#service`,
  name: SITE.name,
  url: `${SITE.url}/`,
  image: `${SITE.url}${SITE.ogImage}`,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
  areaServed: 'Worldwide',
  slogan: 'Software built around your business. Not the other way around.',
  description: SITE.description,
  knowsAbout: [
    'Custom software development',
    'Bespoke SaaS',
    'SaaS product development',
    'AI application development',
    'Product strategy',
    'UX research',
    'Product design',
    'Software engineering',
    'Design systems',
    'Accessibility',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What we build',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bespoke SaaS', url: `${SITE.url}/services/bespoke-saas` } },
      ...BUILD_CLUSTERS.map((c) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: c.label, description: c.summary },
      })),
    ],
  },
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [orgNode, serviceNode, websiteNode] };
---
<BaseLayout
  title="Artifact Digital — Bespoke SaaS & Custom Software Development"
  description="Artifact Digital designs and builds bespoke SaaS for companies with problems off-the-shelf software can't solve: senior product thinking, design, engineering and AI in one team."
  canonical="/"
  preloadImage="/brand_assets/hero-product-reel.webp"
  jsonLd={jsonLd}
>
  <!-- 1. BESPOKE SAAS -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-meta">
          <span class="eyebrow"><span class="eyebrow-dot"></span>The bespoke SaaS agency</span>
        </div>

        <h1 class="hero-heading hero-heading--long">
          <span class="line"><span class="reveal-word"><span>Software built</span></span></span>
          <span class="line"><span class="reveal-word"><span>around your business.</span></span></span>
          <span class="line italic"><span class="reveal-word"><span>Not the other</span></span></span>
          <span class="line italic"><span class="reveal-word"><span>way around.</span></span></span>
        </h1>

        <div class="hero-foot">
          <p class="hero-lede">
            Artifact Digital designs and builds bespoke SaaS and custom software for
            businesses. We pair experienced product, design and engineering people
            with AI, so a small senior team can apply far more thinking and building
            to your problem. The result is better software, built faster, around the
            business itself.
          </p>
          <div class="hero-actions">
            <Button href={CTA.primary.href} label={CTA.primary.label} variant="primary" />
            <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <video
          class="hero-video"
          data-src="/brand_assets/hero-product-reel.mp4"
          data-src-mobile="/brand_assets/hero-product-reel-mobile.mp4"
          data-reel={JSON.stringify(REEL)}
          poster="/brand_assets/hero-product-reel.webp"
          muted loop playsinline autoplay preload="metadata"
          aria-label="Reel of software Artifact builds"
          aria-describedby="heroReelList"
        ></video>
        <p class="hero-reel-caption" aria-hidden="true">
          <span class="hero-reel-caption__name" data-reel-name>{REEL[0].name}</span>
          <span class="hero-reel-caption__status" data-reel-status>{REEL[0].status}</span>
        </p>
        <ul class="sr-only" id="heroReelList">
          {REEL.map((r) => <li>{r.name}: {r.status}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. THE PROBLEM -->
  <section class="section intro" id="problem">
    <div class="container intro-grid">
      <div class="intro-label reveal">
        <span class="section-tag"><span class="tag-dot"></span>The problem</span>
      </div>
      <div class="intro-body">
        <h2 class="intro-heading">
          <span class="reveal-line"><span>Your business shouldn't</span></span>
          <span class="reveal-line"><span>have to fit inside</span></span>
          <span class="reveal-line"><span><em>somebody else's</em> software.</span></span>
        </h2>
        <p class="intro-copy reveal">
          Off-the-shelf software is built for the average company, so every company
          bends to fit it: the workaround everyone knows and nobody wrote down, the
          spreadsheet that quietly became mission-critical, a dozen subscriptions
          stitched together, and a team trained to think the way a vendor's product
          thinks. The parts of your business that make you different are exactly the
          parts generic software can't hold.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. WHY NOW -->
  <section class="speed-module speed-module--reverse" aria-labelledby="why-now-heading">
    <div class="container speed-module__inner">
      <div class="speed-module__copy">
        <span class="section-tag"><span class="tag-dot"></span>Why now</span>
        <h2 class="speed-module__heading" id="why-now-heading">
          AI changed the economics of <em>custom software.</em>
        </h2>
        <p class="speed-module__lede">
          Building software around one company used to take the kind of team and
          timeline few businesses could justify, so most adapted to generic tools and
          worked around the gaps. That has changed. The thinking and building an
          experienced team can apply to a problem has multiplied, and software designed
          around how your business actually works is now a realistic investment.
        </p>
        <ul class="speed-module__points">
          <li>Shaped around your workflows, your language and your customers</li>
          <li>More options explored before you commit to one</li>
          <li>Software that keeps improving as the business changes</li>
        </ul>
        <div class="speed-module__actions">
          <Button href="/how-we-work" label="How we work" variant="primary" />
          <Button href="/insights/bespoke-saas" label="Read the thinking" variant="secondary" />
        </div>
      </div>

      <div class="speed-module__media">
        <img
          class="speed-module__img speed-module__img--main"
          src="/brand_assets/insights/bespoke-module.webp"
          srcset="/brand_assets/insights/bespoke-module-480w.webp 480w, /brand_assets/insights/bespoke-module.webp 634w"
          sizes="(max-width: 900px) 100vw, 560px"
          alt="Modular blocks locking together into a single system"
          width="634" height="473" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 4. THE ARTIFACT MODEL -->
  <section class="section model" id="model" aria-labelledby="model-heading">
    <div class="container model-grid">
      <div class="model-copy">
        <span class="section-tag reveal"><span class="tag-dot"></span>The Artifact model</span>
        <h2 class="model-heading reveal" id="model-heading">More thinking. More building. <em>Less overhead.</em></h2>
        <p class="model-lede reveal">
          Agencies have always grown what they can do by adding people. That model
          has produced great work, and it's where our team comes from. Artifact is
          built on a different equation: experienced people working with AI to explore
          more possibilities, prototype more ideas, test more approaches and iterate
          further than team size alone allows. AI isn't what we sell. It's what lets
          a senior team put far more into the work that matters.
        </p>
      </div>
      <div class="model-table-wrap reveal">
        <table class="model-table">
          <caption class="sr-only">How the traditional agency model and the Artifact model add capability</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Aspect</span></th><th scope="col">Traditional agency model</th><th scope="col">The Artifact model</th></tr>
          </thead>
          <tbody>
            {MODEL_ROWS.map(([label, before, after]) => (
              <tr><th scope="row">{label}</th><td data-label="Traditional">{before}</td><td data-label="Artifact">{after}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. WHAT WE BUILD -->
  <section class="section services" id="what-we-build">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>What we build</span>
        <h2 class="section-heading reveal-line"><span>Software that fits</span></h2>
      </header>
      <p class="home-lede reveal">
        Every company has workflows, customers, data and know-how no generic platform
        was built for. This is what becomes possible when the software is designed
        around them.
      </p>

      <ol class="service-list">
        {BUILD_CLUSTERS.map((c, i) => (
          <li class="service-row reveal-row">
            <a class="service-row__link" href={buildPath(c.id)} aria-label={c.label}></a>
            <span class="service-row__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="service-row__body">
              <h3 class="service-row__title">{c.label}</h3>
              <p class="service-row__desc">{c.summary}</p>
            </div>
            <ul class="service-row__tags">{c.examples.slice(0, 3).map((e) => <li>{e}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p class="home-more reveal"><a class="home-more__link" href="/services/bespoke-saas">Bespoke SaaS, explained<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- 6. HOW WE WORK -->
  <section class="section approach" id="approach">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>How we work</span>
        <h2 class="section-heading reveal-line"><span>Learn before you commit</span></h2>
      </header>

      <ol class="approach-grid approach-grid--five">
        {METHOD.map((m, i) => (
          <li class="approach-card reveal-card">
            <span class="approach-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </li>
        ))}
      </ol>
      <p class="approach-more reveal"><a href="/how-we-work">How we work, in full<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- 7. PROOF -->
  <section class="section work" id="work">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Proof</span>
        <h2 class="section-heading reveal-line"><span>Software we've built</span></h2>
      </header>

      <div class="project-grid">
        {artifactWork.map((p) => <WorkCard entry={p} />)}
      </div>

      {softwareQuotes.length > 0 && (
        <div class="testimonial-grid">
          {softwareQuotes.map((t) => (
            <figure class="testimonial reveal-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="testimonial__role">{t.name}</span>
                <span class="testimonial__sector">{t.role}</span>
                {t.context && <span class="testimonial__context">{t.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section work work--career" id="career-work">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Career work</span>
        <h2 class="section-heading reveal-line"><span>Our founder’s work</span></h2>
      </header>
      <p class="work-attribution reveal">
        These examples represent experience delivering digital products for leading
        organizations. To respect client confidentiality, copyright, and contractual
        obligations, branding and proprietary assets have been removed or anonymized
        while preserving the strategic thinking and design approach behind the work.
      </p>

      <div class="project-grid">
        {careerWork.map((p) => <WorkCard entry={p} />)}
      </div>
      <p class="home-more reveal"><a class="home-more__link" href="/work">See all work<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  {otherQuotes.length > 0 && (
    <section class="section clients" aria-labelledby="clients-heading">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>Artifact's clients</span>
          <h2 class="section-heading reveal-line" id="clients-heading"><span>In their words</span></h2>
        </header>
        <div class="testimonial-grid">
          {otherQuotes.map((t) => (
            <figure class="testimonial reveal-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="testimonial__role">{t.name}</span>
                <span class="testimonial__sector">{t.role}</span>
                {t.context && <span class="testimonial__context">{t.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 8. BUSINESS OUTCOMES -->
  <section class="section outcomes" aria-labelledby="outcomes-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Outcomes</span>
        <h2 class="section-heading reveal-line" id="outcomes-heading"><span>What bespoke software is for</span></h2>
      </header>
      <ul class="outcome-grid">
        {OUTCOMES.map((o) => (
          <li class="outcome reveal-card">
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. CTA -->
  <section class="section contact" id="contact">
    <div class="container contact-inner">
      <span class="section-tag reveal"><span class="tag-dot"></span>Build something</span>

      <h2 class="contact-heading">
        <span class="reveal-line"><span>What could your company</span></span>
        <span class="reveal-line"><span>do if the software were</span></span>
        <span class="reveal-line"><span><em>built around you?</em></span></span>
      </h2>
      <p class="contact-sub reveal">
        Tell us about the workflow you've outgrown, the spreadsheet running a critical
        process, or the product you haven't been able to build. We'll tell you honestly
        whether bespoke software is the answer, and what the first few weeks would look like.
      </p>

      <div class="hero-actions reveal" style="margin: 2rem 0 2.5rem;">
        <Button href={CTA.primary.href} label={CTA.primary.label} variant="primary" />
        <Button href={CTA.work.href} label={CTA.work.label} variant="secondary" />
      </div>

      <a class="contact-email reveal" href="mailto:hello@artifactdigital.co">
        hello@artifactdigital.co
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M2 11h17M13 4l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="contact-grid">
        <div class="contact-block reveal">
          <span class="contact-block__label">Studio</span>
          <p>San Diego, CA<br />Working with teams worldwide</p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">New business</span>
          <p><a href="mailto:hello@artifactdigital.co">hello@artifactdigital.co</a></p>
        </div>
        <div class="contact-block reveal">
          <span class="contact-block__label">Follow</span>
          <p><a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
