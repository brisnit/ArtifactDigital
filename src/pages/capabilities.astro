  /* Progressive disclosure: native details keeps it keyboard- and SR-friendly. */
  .cap-disclose { border-top: 1px solid rgba(17, 17, 17, 0.1); padding-top: 0.85rem; }
  .cap-block--wide .cap-disclose { border-top-color: rgba(255, 255, 255, 0.18); }
  .cap-disclose > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    transition: color 0.25s var(--easing);
  }
  .cap-disclose > summary::-webkit-details-marker { display: none; }
  .cap-disclose > summary:hover { color: var(--ink); }
  .cap-block--wide .cap-disclose > summary { color: rgba(255, 255, 255, 0.7); }
  .cap-block--wide .cap-disclose > summary:hover { color: #fff; }
  .cap-disclose > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .cap-disclose__less { display: none; }
  .cap-disclose[open] .cap-disclose__more { display: none; }
  .cap-disclose[open] .cap-disclose__less { display: inline; }
  .cap-disclose__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }
  .cap-disclose__icon::before,
  .cap-disclose__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 0.3s var(--easing), opacity 0.3s var(--easing);
  }
  .cap-disclose__icon::before { inset: 5px 0 5px 0; height: 2px; }
  .cap-disclose__icon::after { inset: 0 5px 0 5px; width: 2px; }
  .cap-disclose[open] .cap-disclose__icon::after { transform: scaleY(0); opacity: 0; }

  .cap-tags {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cap-tags li {
    padding: 0.36rem 0.7rem;
