  }
  .cap-block--wide .cap-block__body { color: rgba(255, 255, 255, 0.76); font-size: 1.05rem; }
  .cap-block__callout {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: #fff;
    max-width: 54ch;
  }
  .cap-block__note {
    margin: 0;
    padding: 0.7rem 0.9rem;
    background: var(--stone);
    border-left: 2px solid var(--steel-soft);
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--steel);
  }

  .cap-block__link {
    margin-top: auto;
    padding-top: 0.35rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--accent-strong);
    text-decoration: none;
    align-self: flex-start;
  }
  .cap-block__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cap-block--wide .cap-block__link { color: var(--blush); }

  /* Progressive disclosure: native details keeps it keyboard- and SR-friendly. */
  .cap-disclose { border-top: 1px solid rgba(17, 17, 17, 0.1); padding-top: 0.85rem; }
  .cap-block--wide .cap-disclose { border-top-color: rgba(255, 255, 255, 0.18); }
  .cap-disclose > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    transition: color 0.25s var(--easing);
  }
  .cap-disclose > summary::-webkit-details-marker { display: none; }
  .cap-disclose > summary:hover { color: var(--ink); }
  .cap-block--wide .cap-disclose > summary { color: rgba(255, 255, 255, 0.7); }
  .cap-block--wide .cap-disclose > summary:hover { color: #fff; }
  .cap-disclose > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .cap-disclose__less { display: none; }
  .cap-disclose[open] .cap-disclose__more { display: none; }
  .cap-disclose[open] .cap-disclose__less { display: inline; }
  .cap-disclose__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }
  .cap-disclose__icon::before,
  .cap-disclose__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 0.3s var(--easing), opacity 0.3s var(--easing);
  }
  .cap-disclose__icon::before { inset: 5px 0 5px 0; height: 2px; }
  .cap-disclose__icon::after { inset: 0 5px 0 5px; width: 2px; }
  .cap-disclose[open] .cap-disclose__icon::after { transform: scaleY(0); opacity: 0; }

  .cap-tags {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cap-tags li {
    padding: 0.36rem 0.7rem;
    border: 1px solid rgba(17, 17, 17, 0.14);
    border-radius: 2px;
    font-size: 0.855rem;
    line-height: 1.3;
    color: var(--steel);
    background: var(--stone);
  }
  .cap-block--wide .cap-tags li {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.82);
  }

  /* -------------------- 02 Lifecycle -------------------- */
  .cap-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .cap-flow__step {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.6rem);
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: var(--radius-media);
  }
  /* Connector chevrons sit in the gap, and never in the accessibility tree. */
  .cap-flow__step + .cap-flow__step::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(0.75rem, 1.5vw, 1.25rem) / 2 - 3px);
    top: clamp(1.6rem, 2.4vw, 2rem);
    width: 6px;
    height: 6px;
    border-top: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
    transform: rotate(45deg);
  }
  .cap-flow__num {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--accent-strong);
  }
  .cap-flow__phase {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.9rem;
    color: var(--ink);
  }
  .cap-flow__items { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .cap-flow__items li { color: var(--steel); font-size: 0.92rem; line-height: 1.4; }

  /* -------------------- 03 Engagement types -------------------- */
  .cap-problems {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .cap-problem {
    padding: clamp(1.35rem, 2.4vw, 1.9rem);
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: var(--radius-media);
