// The shared method (src/data/method.ts) with the disciplines at work in each
// stage. Artifact has one process; this page shows who does what inside it
// rather than inventing a second one.
const DISCIPLINES_BY_STAGE: Record<string, string[]> = {
  Understand: ['Strategy', 'User research', 'Business requirements', 'Experience audits'],
  Prototype: ['Product & interaction design', 'Working prototypes', 'AI prototyping', 'Usability testing'],
  Build: ['Software engineering', 'Design systems', 'AI integration', 'Accessibility', 'Content platforms'],
  Learn: ['Analytics', 'Research', 'Usability testing', 'Optimization'],
  Evolve: ['Enhancements', 'Training & adoption', 'Roadmap', 'Support'],
};
const LIFECYCLE = METHOD.map((m, i) => ({
  n: String(i + 1).padStart(2, '0'),
  phase: m.title,
  items: DISCIPLINES_BY_STAGE[m.title] ?? [],
}));

const ENGAGEMENT_TYPES = [
  { title: 'Replace software you’ve outgrown', body: 'Retire the workarounds, spreadsheets and stitched-together subscriptions with software built around how you work.' },
  { title: 'New digital products', body: 'Take an idea from opportunity through working production software.' },
  { title: 'Internal platforms', body: 'Give an operation the workflow software its real processes need, from intake to approvals to reporting.' },
  { title: 'Customer portals', body: 'Service and self-service that feel like your company, not a vendor’s template.' },
  { title: 'AI where it earns its place', body: 'Find where AI actually creates value, and integrate it safely into real workflows and products.' },
  { title: 'Platform consolidation', body: 'Reduce redundant systems, content and legacy software into something a team can run.' },
  { title: 'Products to sell', body: 'Turn what your business already knows into software other organizations will pay for.' },
  { title: 'Prototypes before big commitments', body: 'Turn uncertain ideas into working software quickly enough to learn before committing to a major investment.' },
];

const INDUSTRIES = [
  'Government & public sector', 'Healthcare', 'Financial services', 'Higher education',
  'Training & certification', 'Retail & commerce', 'Automotive', 'Consumer electronics',
  'Food & agriculture', 'Nonprofit & community organizations', 'Professional services', 'Technology',
];

const OPERATING_POINTS = [
  'Senior-led from discovery through delivery',
  'Strategy and execution under one team',
  'Experienced people working with AI across research, design, engineering and testing',
  'Rapid working prototypes',
  'Design-to-code continuity',
  'Flexible specialist network when programs require additional scale',
  'Built for focused teams and complex initiatives',
];

const PRIME = [
  { label: 'Custom applications', items: 'Internal tools · Portals · Workflow systems' },
  { label: 'Digital products', items: 'Concept through production software' },
  { label: 'Prototypes / MVPs', items: 'Working software fast enough to learn from' },
  { label: 'AI initiatives', items: 'Readiness · Agentic workflows · Production integration' },
  { label: 'Experience modernization', items: 'Legacy replacement · Platform consolidation' },
  { label: 'UX & design systems', items: 'Research · Architecture · Design systems' },
  { label: 'Research & strategy', items: 'Discovery · Roadmaps · Requirements' },
  { label: 'Websites & platforms', items: 'Enterprise · Government · Editorial · Commerce' },
];

// Headline specialisms a prime scans for, each with what it actually covers.
const TEAMING = [
  { label: 'UX & product', items: 'UX strategy · UX/UI design · Product strategy · Service design' },
  { label: 'AI', items: 'AI experience design · Agentic workflows · LLM integration' },
  { label: 'Accessibility', items: 'WCAG 2.1 AA · WCAG 2.2 · Section 508 · Audits & remediation' },
  { label: 'Design systems', items: 'Component libraries · Tokens · Governance · Implementation' },
  { label: 'Prototyping', items: 'Working prototypes · Concept validation · MVP definition' },
  { label: 'Front-end', items: 'React · TypeScript · Design-system implementation · Performance' },
  { label: 'Research', items: 'User research · Usability testing · Experience audits' },
  { label: 'Digital strategy', items: 'Discovery · Roadmaps · Requirements · Customer journey' },
];

const ENGAGEMENT_MODELS = [
  { n: '01', title: 'Discovery & strategy', body: 'Focused research and definition before a larger investment.' },
  { n: '02', title: 'Prototype / MVP', body: 'Move quickly from concept to working software.' },
  { n: '03', title: 'Full product delivery', body: 'Strategy through design, engineering and launch.' },
  { n: '04', title: 'Embedded specialist team', body: 'Add senior Artifact expertise to an existing internal or prime-contractor team.' },
  { n: '05', title: 'Ongoing optimization', body: 'Support, analytics and iterative product evolution after launch.' },
];

// Grouped by what it does for the client, not by vendor. Everything named here
// is either used to build this site or appears in a published case study.
const TECH = [
  { group: 'Experience', items: ['Modern web frameworks', 'React', 'Astro', 'TypeScript', 'Responsive systems', 'Design systems', 'Interactive applications'] },
  { group: 'Platform', items: ['CMS', 'Headless CMS', 'WordPress', 'Shopify', 'SaaS', 'Cloud applications', 'APIs', 'Data'] },
  { group: 'AI', items: ['LLMs', 'RAG', 'Agents', 'Automation', 'Generative interfaces', 'Predictive systems'] },
  { group: 'Operations', items: ['Cloud deployment', 'Vercel', 'Authentication', 'Analytics', 'Monitoring', 'CI/CD', 'Performance'] },
];

// --- Proof -------------------------------------------------------------------
// Split on priorRole so the two kinds of credibility can never blur together.
// That distinction is the whole point for a procurement reader.
const allWork = sortWork(await getCollection('work'));
const artifactWork = allWork.filter((w) => !w.data.priorRole).slice(0, 3);
const careerWork = allWork.filter((w) => w.data.priorRole).slice(0, 3);

const path = '/capabilities';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${SITE.url}${path}#service`,
      name: 'Software strategy, design, AI and engineering',
      serviceType: 'Digital strategy, product design, software engineering and artificial intelligence',
      description:
        'The expertise Artifact Digital brings to designing and building bespoke software: strategy, research, product and interaction design, software engineering, AI, accessibility and content platforms, in one senior team.',
      url: `${SITE.url}${path}`,
      provider: { '@id': `${SITE.url}/#organization` },
      areaServed: 'United States and Canada',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Artifact Digital capabilities',
        itemListElement: CAPABILITIES.map((c) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: c.title, description: c.body },
        })),
      },
    },
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Capabilities', path },
    ]),
  ],
};
---
<BaseLayout
  title="Artifact Digital Capabilities | Strategy, UX, AI & Software Engineering"
  description="The expertise behind the bespoke software Artifact Digital builds: digital strategy, UX and product design, software engineering, AI, accessibility, CMS and public-sector delivery, in one senior team."
  canonical={path}
  bodyClass="case-page capabilities"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="case-hero cap-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Capabilities' }]} />
      <span class="eyebrow reveal"><span class="eyebrow-dot"></span>Capabilities</span>
      <h1 class="case-title">
        <span class="reveal-line"><span>The expertise</span></span>
        <span class="reveal-line italic"><span>behind the software.</span></span>
      </h1>
      <p class="case-lede reveal">
        What We Build is the software. Capabilities are the expertise it takes to build
        it well. Great bespoke software doesn’t come from engineering alone: it means
        understanding the business, the people using it, the interface, the system and the
        technology as one problem. Artifact brings those disciplines together in one senior
        team working with AI, rather than selling them as separate departments.
      </p>
      <div class="cap-hero__actions reveal">
        <Button href="/contact?intent=build" label="Tell Us the Problem" variant="primary" />
        <Button href="/services" label="Explore What We Build" variant="secondary" />
      </div>
      <p class="cap-hero__arc reveal">
        <span>Strategy</span><span>Design</span><span>AI</span><span>Engineering</span>
        <span class="cap-hero__arc-tail">under one senior team</span>
      </p>
      <p class="cap-hero__xref reveal">
        Looking for the kinds of software this expertise produces? See
        <a href="/services">What We Build</a>.
      </p>
    </div>
  </section>

  <!-- 01 — CAPABILITIES -->
  <section class="section cap-section" id="what-we-do" aria-labelledby="cap-do-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>01 — Capabilities</span>
        <h2 class="section-heading reveal-line" id="cap-do-heading"><span>Ten disciplines, one team</span></h2>
      </header>
      <p class="cap-intro reveal">
        Clients rarely need just one of these. Each exists to make the software better, and
        they work best when the same people carry a problem through all of them.
      </p>

      <div class="cap-matrix">
        {CAPABILITIES.map((c) => (
          <article class:list={['cap-block', 'reveal-card', c.wide && 'cap-block--wide', c.span && 'cap-block--span']}>
            <div class="cap-block__head">
              <span class="cap-block__num" aria-hidden="true">{c.n}</span>
              <h3 class="cap-block__title">{c.title}</h3>
            </div>
            <p class="cap-block__body">{c.body}</p>
            {c.callout && <p class="cap-block__callout">{c.callout}</p>}
            {c.note && <p class="cap-block__note">{c.note}</p>}
            <details class="cap-disclose">
              <summary>
                <span class="cap-disclose__label">
                  <span class="cap-disclose__more">{c.items.length} capabilities</span>
                  <span class="cap-disclose__less">Hide capabilities</span>
                </span>
                <span class="cap-disclose__icon" aria-hidden="true"></span>
              </summary>
              <ul class="cap-tags">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
            </details>
            {c.href && (
              <a class="cap-block__link" href={c.href}>
                {c.linkLabel}<span aria-hidden="true"> →</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 — LIFECYCLE -->
  <section class="section cap-section cap-section--ink" aria-labelledby="cap-lifecycle-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>02 — The method</span>
        <h2 class="section-heading reveal-line" id="cap-lifecycle-heading"><span>One method. Every discipline in it.</span></h2>
      </header>
      <ol class="cap-flow">
        {LIFECYCLE.map((p) => (
          <li class="cap-flow__step reveal-card">
            <span class="cap-flow__num" aria-hidden="true">{p.n}</span>
            <h3 class="cap-flow__phase">{p.phase}</h3>
            <ul class="cap-flow__items">
              {p.items.map((i) => <li>{i}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 — ENGAGEMENT TYPES -->
  <section class="section cap-section" aria-labelledby="cap-problems-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>03 — Where we help</span>
        <h2 class="section-heading reveal-line" id="cap-problems-heading"><span>Complex problems are where we are most useful.</span></h2>
      </header>
      <div class="cap-problems">
        {ENGAGEMENT_TYPES.map((e) => (
          <article class="cap-problem reveal-card">
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 — INDUSTRIES -->
  <section class="section cap-section cap-section--alt" aria-labelledby="cap-industries-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>04 — Industries</span>
        <h2 class="section-heading reveal-line" id="cap-industries-heading"><span>Industries</span></h2>
      </header>
      <p class="cap-intro reveal">
        Our team brings experience across complex, regulated and customer-facing environments.
      </p>
      <ul class="cap-industries">
        {INDUSTRIES.map((i) => <li class="reveal-card">{i}</li>)}
      </ul>
    </div>
  </section>

  <!-- 05 — OPERATING MODEL -->
  <section class="section cap-section" aria-labelledby="cap-model-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>05 — Operating model</span>
        <h2 class="section-heading reveal-line" id="cap-model-heading"><span>Senior expertise. One integrated team.</span></h2>
      </header>
      <div class="cap-model">
        <div class="cap-model__copy">
          <p class="reveal">
            Most engagements split strategy, design and technology across layers of teams, then
            spend the budget translating between them.
          </p>
          <p class="cap-model__lead reveal">
            The senior people defining the problem remain involved through the solution.
          </p>
          <ul class="cap-model__points">
            {OPERATING_POINTS.map((p) => <li class="reveal">{p}</li>)}
          </ul>
        </div>
        <div class="cap-model__equation reveal" role="img" aria-label="Strategy plus design plus AI plus engineering equals Artifact">
          <ul class="cap-eq__terms" aria-hidden="true">
            <li>Strategy</li>
            <li>Design</li>
            <li>AI</li>
            <li>Engineering</li>
          </ul>
          <span class="cap-eq__rule" aria-hidden="true"></span>
          <span class="cap-eq__sum" aria-hidden="true">Artifact</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — PROOF -->
  <section class="section cap-section cap-section--alt" aria-labelledby="cap-proof-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>06 — Selected proof</span>
        <h2 class="section-heading reveal-line" id="cap-proof-heading"><span>Selected proof</span></h2>
      </header>

      <div class="cap-proof__group">
        <h3 class="cap-proof__label reveal">Built by Artifact</h3>
        <p class="cap-proof__note reveal">
          Software Artifact Digital designed and built, each labelled with where it stands.
          This is the company’s own past performance.
        </p>
        <div class="project-grid project-grid--trio">
          {artifactWork.map((entry) => <WorkCard entry={entry} headingLevel="h4" showTier />)}
        </div>
      </div>

      <div class="cap-proof__group">
        <h3 class="cap-proof__label reveal">Experience behind Artifact</h3>
        <p class="cap-proof__note reveal">
          Engagements founder Britt Midgette led in director roles at previous agencies, before
          Artifact Digital existed, some of them with people who now work on Artifact projects.
          Each card says which. This is the team’s track record and the judgment behind the
          company — <strong>it is not presented as Artifact corporate past performance.</strong>
        </p>
        <div class="project-grid project-grid--trio">
          {careerWork.map((entry) => <WorkCard entry={entry} headingLevel="h4" showTier />)}
        </div>
      </div>

      <p class="cap-proof__more reveal">
        <a href="/work">See all case studies<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

