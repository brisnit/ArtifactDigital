              <li>
                <span class="cap-specialisms__label">{t.label}</span>
                <span class="cap-specialisms__items">{t.items}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cap-col cap-col--teaming reveal">
          <h3 class="cap-col__title">Teaming / subcontracting</h3>
