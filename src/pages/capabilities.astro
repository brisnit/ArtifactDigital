// --- Capability architecture -------------------------------------------------
// `wide` promotes a capability to a full-width row so the grid has rhythm
// rather than twelve identical tiles. `callout` is the one line a skim-reader
// should take away.
interface Capability {
  n: string;
  title: string;
  body: string;
  items: string[];
  href?: string;
  linkLabel?: string;
  callout?: string;
  /** Full-width, dark — reserved for the two capabilities carrying a thesis. */
  wide?: boolean;
  /** Full-width, light — keeps the 2-col flow from stranding a lone card. */
  span?: boolean;
  /** Attributed provenance. Must state plainly whose experience it is. */
  note?: string;
}

