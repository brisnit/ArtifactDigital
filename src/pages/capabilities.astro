    font-size: 1.12rem;
    letter-spacing: -0.015em;
    margin: 0 0 0.55rem;
    color: var(--ink);
  }
  .cap-problem p { margin: 0; color: var(--steel); line-height: 1.6; font-size: 0.97rem; }

  /* -------------------- 04 Industries -------------------- */
  .cap-industries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
