  { label: 'Design systems', items: 'Component libraries · Tokens · Governance · Implementation' },
  { label: 'Prototyping', items: 'Working prototypes · Concept validation · MVP definition' },
  { label: 'Front-end', items: 'React · TypeScript · Design-system implementation · Performance' },
  { label: 'Research', items: 'User research · Usability testing · Experience audits' },
  { label: 'Digital strategy', items: 'Discovery · Roadmaps · Requirements · Customer journey' },
];

const ENGAGEMENT_MODELS = [
  { n: '01', title: 'Discovery & strategy', body: 'Focused research and definition before a larger investment.' },
  { n: '02', title: 'Prototype / MVP', body: 'Move quickly from concept to working software.' },
