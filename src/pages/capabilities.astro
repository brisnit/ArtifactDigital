// --- Capability architecture -------------------------------------------------
// `wide` promotes a capability to a full-width row so the grid has rhythm
// rather than twelve identical tiles. `callout` is the one line a skim-reader
// should take away.
interface Capability {
  n: string;
  title: string;
  body: string;
  items: string[];
  href?: string;
  linkLabel?: string;
  callout?: string;
  /** Full-width, dark — reserved for the two capabilities carrying a thesis. */
  wide?: boolean;
  /** Full-width, light — keeps the 2-col flow from stranding a lone card. */
  span?: boolean;
  /** Attributed provenance. Must state plainly whose experience it is. */
  note?: string;
}

const CAPABILITIES: Capability[] = [
  {
    n: '01',
    title: 'Digital & product strategy',
    body: 'We find where purpose-built software creates real leverage for the business, and where off-the-shelf is the better call, then turn that into a plan someone can actually execute.',
    href: '/services/digital-strategy',
    linkLabel: 'Digital strategy',
    items: [
      'Product strategy', 'Opportunity identification', 'Build-or-buy decisions',
      'Business requirements', 'Service design', 'Customer journey mapping',
      'Digital ecosystem strategy', 'Competitive research', 'Technology planning',
      'Roadmaps', 'MVP definition', 'Discovery programs', 'Stakeholder alignment',
    ],
