    ],
  },
  {
    n: '10',
    title: 'Training, enablement & adoption',
    body: 'Software succeeds when the people using it understand it, trust it and know how to make it part of their work.',
    span: true,
    items: [
      'User training', 'Administrator training', 'Product onboarding', 'Documentation',
      'Knowledge bases', 'Digital adoption', 'Learning experience design', 'AI-assisted training',
      'Predictive learning', 'Role-based learning', 'Train-the-trainer', 'Change enablement',
