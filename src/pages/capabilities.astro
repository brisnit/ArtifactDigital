  }

  /* -------------------- 06 Proof -------------------- */
  .cap-proof__group + .cap-proof__group { margin-top: clamp(3rem, 6vw, 5rem); }
  .cap-proof__label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }
  .cap-proof__note {
    max-width: 70ch;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: rgba(255, 255, 255, 0.7);
    color: var(--steel);
    font-size: 0.95rem;
    line-height: 1.65;
  }
