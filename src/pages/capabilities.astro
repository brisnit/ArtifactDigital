    border-radius: var(--radius-media);
    transition: border-color 0.3s var(--easing), box-shadow 0.3s var(--easing);
  }
  .cap-section--alt .cap-block { background: #fff; }
  .cap-block:hover { border-color: rgba(17, 17, 17, 0.2); box-shadow: var(--shadow-card); }
  /* Full width, still light. Varies the rhythm, and keeps an odd run of cards
     from stranding one beside an empty cell. */
  .cap-block--span { grid-column: 1 / -1; }
