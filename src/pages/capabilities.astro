const INDUSTRIES = [
  'Government & public sector', 'Healthcare', 'Financial services', 'Higher education',
  'Training & certification', 'Retail & commerce', 'Automotive', 'Consumer electronics',
  'Food & agriculture', 'Nonprofit & community organizations', 'Professional services', 'Technology',
