  <CtaBand
    heading="Bring us the complicated part."
    sub={"Tell us what you’re trying to solve: software you’ve outgrown, a product you want to launch, a public service to modernize, or a question about where AI belongs. We’ll help determine whether software is the answer, then bring the strategy, design and engineering to build it."}
    primary={{ label: 'Tell Us the Problem', href: '/contact?intent=build' }}
    secondary={CTA.work}
  />
</BaseLayout>

<style>
  /* ============================================================
     Capabilities — extends the site system, adds nothing new to it.
     Everything here is page-scoped; shared patterns (section-head,
     reveal, btn, work-grid, project-card) come from global.css.
     ============================================================ */

  /* The arc adds its own rule + margin below the hero, so trim the hero's
     bottom padding to keep the section rhythm identical to the rest of the site. */
  .cap-hero { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .cap-hero__xref { margin: 1.25rem 0 0; max-width: 70ch; color: var(--steel); font-size: 0.95rem; line-height: 1.6; }
  .cap-hero__xref a { color: var(--accent-strong); text-underline-offset: 3px; }

  .cap-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  /* .btn-secondary ships white-on-transparent for dark heroes. This hero is
     white, so it needs the same light-surface treatment .case-cta uses. */
  .cap-hero__actions :global(.btn-secondary) {
    color: var(--ink);
    border-color: rgba(17, 17, 17, 0.4);
  }
  .cap-hero__actions :global(.btn-secondary:hover) {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  /* The engagement arc — a quiet spine under the hero, not a badge row. */
  /* The four disciplines, stated plainly in the first viewport. This is the
     one thing a prime or an RFP evaluator must take away above the fold. */
  .cap-hero__arc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 2.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(0.92rem, 1.5vw, 1.12rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .cap-hero__arc span + span:not(.cap-hero__arc-tail)::before {
    content: '+';
    margin-right: 1rem;
    color: var(--accent);
    font-weight: 400;
  }
  .cap-hero__arc .cap-hero__arc-tail {
    font-weight: 400;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    color: var(--steel-soft);
  }
  .cap-hero__arc .cap-hero__arc-tail::before {
    content: '·';
    margin-right: 1rem;
    color: var(--steel-soft);
  }

  .cap-section--alt { background: var(--stone); }

  /* One dark beat in the middle of a long light page. The lifecycle earns it:
     it is the section that states the whole promise of the page in six words. */
  .cap-section--ink { background: var(--ink); }
  .cap-section--ink .section-heading { color: #fff; }
  .cap-section--ink .section-tag { color: rgba(255, 255, 255, 0.66); }
  .cap-section--ink .cap-flow__step {
    background: rgba(255, 255, 255, 0.045);
    border-color: rgba(255, 255, 255, 0.14);
  }
  .cap-section--ink .cap-flow__num { color: var(--blush); }
  .cap-section--ink .cap-flow__phase { color: #fff; }
  .cap-section--ink .cap-flow__items li { color: rgba(255, 255, 255, 0.72); }

  .cap-intro {
    max-width: 62ch;
    margin: -0.75rem 0 clamp(2rem, 4vw, 3rem);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.65;
    color: var(--steel);
  }

  .cap-subhead {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  /* -------------------- 01 Capability matrix -------------------- */
  .cap-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .cap-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: var(--radius-media);
    transition: border-color 0.3s var(--easing), box-shadow 0.3s var(--easing);
  }
  .cap-section--alt .cap-block { background: #fff; }
  .cap-block:hover { border-color: rgba(17, 17, 17, 0.2); box-shadow: var(--shadow-card); }
  /* Full width, still light. Varies the rhythm, and keeps an odd run of cards
     from stranding one beside an empty cell. */
  .cap-block--span { grid-column: 1 / -1; }
  .cap-block--span .cap-block__title { font-size: clamp(1.3rem, 2.4vw, 1.75rem); }

  /* The two capabilities that carry a thesis get the full measure, dark. */
  .cap-block--wide {
    grid-column: 1 / -1;
    background: var(--ink);
    border-color: var(--ink);
  }
  .cap-block--wide:hover { border-color: var(--ink); }
  .cap-block__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .cap-block__num {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--accent-strong);
    flex: none;
  }
  .cap-block--wide .cap-block__num { color: var(--blush); }
  .cap-block__title {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
  }
  .cap-block--wide .cap-block__title { color: #fff; font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .cap-block__body {
    margin: 0;
    color: var(--steel);
    line-height: 1.65;
