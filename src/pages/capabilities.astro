    border-radius: var(--radius-media);
  }
  /* Connector chevrons sit in the gap, and never in the accessibility tree. */
  .cap-flow__step + .cap-flow__step::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(0.75rem, 1.5vw, 1.25rem) / 2 - 3px);
