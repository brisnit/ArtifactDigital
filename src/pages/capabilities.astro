};
---
<BaseLayout
  title="Artifact Digital Capabilities | Strategy, UX, AI & Software Engineering"
  description="Explore Artifact Digital's capabilities across digital strategy, UX/UI design, custom software, AI, enterprise websites, accessibility, CMS, product engineering and digital modernization."
  canonical={path}
  bodyClass="case-page capabilities"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="case-hero cap-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Capabilities' }]} />
      <span class="eyebrow reveal"><span class="eyebrow-dot"></span>Capabilities</span>
      <h1 class="case-title">
        <span class="reveal-line"><span>Strategy through</span></span>
        <span class="reveal-line italic"><span>shipped software.</span></span>
      </h1>
      <p class="case-lede reveal">
        Artifact Digital brings strategy, experience design, artificial intelligence and
        engineering together under one senior team. We help organizations modernize digital
        ecosystems, launch new products, improve customer experiences and build software
        around the way their business actually works.
      </p>
      <div class="cap-hero__actions reveal">
        <Button href={CTA.talk.href} label="Talk to Artifact" variant="primary" />
        <Button href="/work" label="View our work" variant="secondary" />
      </div>
      <p class="cap-hero__arc reveal">
        <span>Strategy</span><span>Design</span><span>AI</span><span>Engineering</span>
        <span class="cap-hero__arc-tail">under one senior team</span>
      </p>
    </div>
  </section>

  <!-- 01 — CAPABILITIES -->
  <section class="section cap-section" id="what-we-do" aria-labelledby="cap-do-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>01 — Capabilities</span>
        <h2 class="section-heading reveal-line" id="cap-do-heading"><span>What we can do</span></h2>
      </header>
      <p class="cap-intro reveal">
        Twelve areas, taken on individually or as one continuous engagement.
      </p>

      <div class="cap-matrix">
        {CAPABILITIES.map((c) => (
          <article class:list={['cap-block', 'reveal-card', c.wide && 'cap-block--wide', c.span && 'cap-block--span']}>
            <div class="cap-block__head">
              <span class="cap-block__num" aria-hidden="true">{c.n}</span>
              <h3 class="cap-block__title">{c.title}</h3>
            </div>
            <p class="cap-block__body">{c.body}</p>
            {c.callout && <p class="cap-block__callout">{c.callout}</p>}
            {c.note && <p class="cap-block__note">{c.note}</p>}
            <details class="cap-disclose">
              <summary>
                <span class="cap-disclose__label">
                  <span class="cap-disclose__more">{c.items.length} capabilities</span>
                  <span class="cap-disclose__less">Hide capabilities</span>
                </span>
                <span class="cap-disclose__icon" aria-hidden="true"></span>
              </summary>
              <ul class="cap-tags">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
            </details>
            {c.href && (
              <a class="cap-block__link" href={c.href}>
                {c.linkLabel}<span aria-hidden="true"> →</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 — LIFECYCLE -->
  <section class="section cap-section cap-section--ink" aria-labelledby="cap-lifecycle-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>02 — Lifecycle</span>
        <h2 class="section-heading reveal-line" id="cap-lifecycle-heading"><span>From opportunity to operation.</span></h2>
      </header>
      <ol class="cap-flow">
        {LIFECYCLE.map((p) => (
          <li class="cap-flow__step reveal-card">
            <span class="cap-flow__num" aria-hidden="true">{p.n}</span>
            <h3 class="cap-flow__phase">{p.phase}</h3>
            <ul class="cap-flow__items">
              {p.items.map((i) => <li>{i}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 — ENGAGEMENT TYPES -->
  <section class="section cap-section" aria-labelledby="cap-problems-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>03 — Where we help</span>
        <h2 class="section-heading reveal-line" id="cap-problems-heading"><span>Complex problems are where we are most useful.</span></h2>
      </header>
      <div class="cap-problems">
        {ENGAGEMENT_TYPES.map((e) => (
          <article class="cap-problem reveal-card">
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 — INDUSTRIES -->
  <section class="section cap-section cap-section--alt" aria-labelledby="cap-industries-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>04 — Industries</span>
        <h2 class="section-heading reveal-line" id="cap-industries-heading"><span>Industries</span></h2>
      </header>
      <p class="cap-intro reveal">
        Our team brings experience across complex, regulated and customer-facing environments.
      </p>
      <ul class="cap-industries">
        {INDUSTRIES.map((i) => <li class="reveal-card">{i}</li>)}
      </ul>
    </div>
  </section>

  <!-- 05 — OPERATING MODEL -->
  <section class="section cap-section" aria-labelledby="cap-model-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>05 — Operating model</span>
        <h2 class="section-heading reveal-line" id="cap-model-heading"><span>Senior expertise. One integrated team.</span></h2>
      </header>
      <div class="cap-model">
        <div class="cap-model__copy">
          <p class="reveal">
            Most engagements split strategy, design and technology across layers of teams, then
            spend the budget translating between them.
          </p>
          <p class="cap-model__lead reveal">
            The senior people defining the problem remain involved through the solution.
          </p>
          <ul class="cap-model__points">
            {OPERATING_POINTS.map((p) => <li class="reveal">{p}</li>)}
          </ul>
        </div>
        <div class="cap-model__equation reveal" role="img" aria-label="Strategy plus design plus AI plus engineering equals Artifact">
          <ul class="cap-eq__terms" aria-hidden="true">
            <li>Strategy</li>
            <li>Design</li>
            <li>AI</li>
            <li>Engineering</li>
          </ul>
          <span class="cap-eq__rule" aria-hidden="true"></span>
          <span class="cap-eq__sum" aria-hidden="true">Artifact</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — PROOF -->
  <section class="section cap-section cap-section--alt" aria-labelledby="cap-proof-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>06 — Selected proof</span>
        <h2 class="section-heading reveal-line" id="cap-proof-heading"><span>Selected proof</span></h2>
      </header>

      <div class="cap-proof__group">
        <h3 class="cap-proof__label reveal">Artifact corporate work</h3>
        <p class="cap-proof__note reveal">
          Products Artifact Digital designed and built as a studio. This is the company's own
          past performance.
        </p>
        <div class="project-grid">
          {artifactWork.map((entry) => <WorkCard entry={entry} headingLevel="h4" />)}
        </div>
      </div>

      <div class="cap-proof__group">
        <h3 class="cap-proof__label reveal">Principal &amp; team experience</h3>
        <p class="cap-proof__note reveal">
          Engagements led by founder Britt Midgette in a director role at previous agencies,
          before Artifact Digital existed. This is the principal's track record and the judgment
          now embedded in the studio — <strong>it is not presented as Artifact corporate past
          performance.</strong>
        </p>
        <div class="project-grid">
          {careerWork.map((entry) => <WorkCard entry={entry} headingLevel="h4" />)}
        </div>
      </div>

      <p class="cap-proof__more reveal">
        <a href="/work">See all case studies<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <!-- 07 — PUBLIC SECTOR -->
  <section class="section cap-section" id="public-sector" aria-labelledby="cap-gov-heading">
    <div class="container">
      <header class="section-head">
