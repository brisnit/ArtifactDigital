---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import WorkCard from '../../components/WorkCard.astro';
import { SITE, orgNode, breadcrumb, CTA } from '../../data/site';
import { relatedCases } from '../../lib/related';
import { METHOD } from '../../data/method';
import { BUILD_CLUSTERS, buildPath } from '../../data/build';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { service: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const path = `/services/${entry.id}`;
const url = `${SITE.url}${path}`;

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const cases = await relatedCases(d.relatedTags);
const related = d.relatedServices.length
  ? allServices.filter((s) => d.relatedServices.includes(s.id))
  : allServices.filter((s) => s.id !== entry.id && !s.data.flagship).slice(0, 3);

// Every service page hangs off the same parent: What We Do. The five primary
// services are the front door; everything else is depth reached from them, and
// each says what it contributes to the one method — never a process of its own.
const parent = { name: 'What We Do', href: '/services' };
const methodFit = d.inMethod
  .map((m) => ({ ...m, n: METHOD.findIndex((s) => s.title === m.stage) + 1 }))
  .sort((a, b) => a.n - b.n);
const builds = d.buildsWith
  .map((id) => BUILD_CLUSTERS.find((c) => c.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const pad = (n: number) => String(n).padStart(2, '0');

// Body copy may carry inline [text](/path) links; render them as real anchors.
const linkify = (text: string) =>
  text
    .split(/(\[[^\]]+\]\([^)\s]+\))/g)
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
      return m ? { text: m[1], href: m[2] } : { text: part, href: null };
    });

// Varied, positioning-aligned calls to action, chosen per page in its JSON.
const PRIMARY = {
  build: CTA.primary,
  problem: { label: 'Tell Us About Your Project', href: '/contact?intent=build' },
  audit: CTA.audit,
  ai: { label: 'Talk Through an AI Idea', href: '/contact?intent=ai-assessment' },
  talk: CTA.talk,
};
const SECONDARY = {
  'what-we-build': { label: 'See What We Do', href: '/services' },
  'how-we-work': { label: 'See How We Work', href: '/how-we-work' },
  work: CTA.work,
  audit: CTA.audit,
};
const ctaSub =
  d.ctaSub ??
  "Tell us the problem. We'll tell you honestly whether software is the answer — and bring the strategy, design, engineering and AI to build it.";

const serviceNode = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: d.title,
  serviceType: d.title,
  description: d.description,
  url,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: 'Worldwide',
  audience: { '@type': 'BusinessAudience', audienceType: 'Businesses building bespoke software' },
};
const faqNode = d.faq.length
  ? {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    serviceNode,
    ...(faqNode ? [faqNode] : []),
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: parent.name, path: parent.href },
      { name: d.title, path },
    ]),
  ],
};
---
<BaseLayout
  title={d.metaTitle}
  description={d.description}
  canonical={path}
  bodyClass="case-page service-page"
  jsonLd={jsonLd}
>
  <section class="case-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, parent, { name: d.navLabel }]} />
      <span class="eyebrow reveal"><span class="eyebrow-dot"></span>{d.eyebrow}</span>
      <h1 class="case-title">
        {d.heroTitleLines.map((l) => (
          <span class:list={["reveal-line", l.italic && "italic"]}><span>{l.text}</span></span>
        ))}
      </h1>
      <p class="case-lede reveal">{d.lede}</p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section service-intro">
    <div class="container service-prose">
      {d.intro.map((p) => (
        <p class="reveal">{linkify(p).map((s) => (s.href ? <a href={s.href}>{s.text}</a> : s.text))}</p>
      ))}
    </div>
  </section>

  <!-- TEACHING SECTIONS -->
  {d.sections.map((s) => (
    <section class="section service-section">
      <div class="container service-section__grid">
        <div class="service-section__head">
          <h2 class="service-section__heading reveal-line"><span>{s.heading}</span></h2>
        </div>
        <div class="service-prose service-section__body">
          {s.body.map((p) => (
            <p class="reveal">{linkify(p).map((x) => (x.href ? <a href={x.href}>{x.text}</a> : x.text))}</p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- WHAT THIS COVERS (optional) -->
  {d.capabilities && d.capabilities.length > 0 && (
    <section class="section service-capabilities">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>In practice</span>
          <h2 class="section-heading reveal-line"><span>What this covers</span></h2>
        </header>
        <ul class="capability-grid">
          {d.capabilities.map((c) => <li class="capability reveal">{c}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- THE METHOD: whole method on the flagship, this discipline's part of it elsewhere -->
  {d.flagship ? (
    <section class="section case-pillars">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>How we work</span>
          <h2 class="section-heading reveal-line"><span>How it gets built</span></h2>
        </header>
        <div class="pillar-grid pillar-grid--five">
          {METHOD.map((m, i) => (
            <article class="pillar reveal-card">
              <span class="pillar__num">{pad(i + 1)}</span>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </article>
          ))}
        </div>
        <p class="home-more reveal"><a class="home-more__link" href="/how-we-work">How we work, in full<span aria-hidden="true"> →</span></a></p>
      </div>
    </section>
  ) : methodFit.length > 0 && (
    <section class="section method-fit" aria-labelledby="method-fit-heading">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>How we work</span>
          <h2 class="section-heading reveal-line" id="method-fit-heading"><span>Where it fits in the method</span></h2>
        </header>
        <p class="home-lede reveal">
          Every Artifact engagement runs on one method: {METHOD.map((m) => m.title).join(' → ')}.
          These are the stages where {d.title} does the most work. <a href="/how-we-work">See how we work</a>.
        </p>
        <ol class="method-fit__list">
          {methodFit.map((m) => (
            <li class="method-fit__row reveal">
              <span class="method-fit__stage"><span class="method-fit__num">{pad(m.n)}</span>{m.stage}</span>
              <p class="method-fit__body">{m.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- DELIVERABLES + WHO IT'S FOR -->
  <section class="section service-lists">
    <div class="container service-lists__grid">
      <div>
        <h2 class="service-list__title reveal-line"><span>What you get</span></h2>
        <ul class="ticklist">
          {d.deliverables.map((x) => <li class="reveal">{x}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="service-list__title reveal-line"><span>Who it's for</span></h2>
        <ul class="ticklist">
          {d.whoFor.map((x) => <li class="reveal">{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- RELATED WORK, labeled by proof tier -->
  {cases.length > 0 && (
    <section class="section related-work">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>Related work</span>
          <h2 class="section-heading reveal-line"><span>Proof, not promises</span></h2>
        </header>
        <div class="project-grid">
          {cases.map((c) => <WorkCard entry={c} showTier />)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {d.faq.length > 0 && (
    <section class="section service-faq">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>Questions</span>
          <h2 class="section-heading reveal-line"><span>Common questions</span></h2>
        </header>
        <dl class="faq-list">
          {d.faq.map((f) => (
            <div class="faq-item reveal">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- CONNECTIONS: the software this helps build, and the capabilities beside it -->
  {d.flagship ? related.length > 0 && (
    <section class="section related-services">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>Capabilities</span>
          <h2 class="section-heading reveal-line"><span>The expertise behind it</span></h2>
        </header>
        <div class="service-link-grid">
          {related.map((s) => (
            <a class="service-link-card reveal-card" href={`/services/${s.id}`}>
              <h3>{s.data.navLabel}</h3>
              <p>{s.data.summary}</p>
              <span class="service-link-card__more">Explore →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (builds.length > 0 || related.length > 0) && (
    <section class="section related-services service-connect">
      <div class="container">
        <header class="section-head">
          <span class="section-tag reveal"><span class="tag-dot"></span>What we build</span>
          <h2 class="section-heading reveal-line"><span>What this helps us build</span></h2>
        </header>
        {builds.length > 0 && (
          <div class="service-link-grid">
            {builds.map((c) => (
              <a class="service-link-card reveal-card" href={buildPath(c.id)}>
                <h3>{c.label}</h3>
                <p>{c.summary}</p>
                <span class="service-link-card__more">See examples →</span>
              </a>
            ))}
          </div>
        )}
        {related.length > 0 && (
          <>
            <h3 class="service-connect__title reveal">Works alongside</h3>
            <ul class="wwb-practice__list">
              {related.map((s) => (
                <li><a href={`/services/${s.id}`}>{s.data.navLabel}<span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <CtaBand heading={d.ctaHeading} sub={ctaSub} primary={PRIMARY[d.cta.primary]} secondary={SECONDARY[d.cta.secondary]} />
</BaseLayout>
