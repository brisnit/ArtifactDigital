---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, orgNode, breadcrumb, CTA } from '../../data/site';
import { PLAYBOOKS, playbookPath } from '../../data/playbooks';
import { BUILD_CLUSTERS, BUILD_PROOF, buildPath, type BuildProof } from '../../data/build';
import { DOORS } from '../../data/doors';
import { caseTier, TIER_LABEL, type Tier } from '../../lib/proof';

// How We Help: the three doors first, because people arrive with a situation.
// The five services sit under them for anyone who wants the detail.

const work = await getCollection('work');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const primaryIds = BUILD_CLUSTERS.map((c) => c.id);
const primary = primaryIds
  .map((id) => services.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const deeper = services.filter((s) => !primaryIds.includes(s.id));

// Proof tiers come from the case itself (src/lib/proof.ts), never from this
// page's copy, so prior-agency work can't be relabeled as Artifact's.
function resolve(p: BuildProof) {
  if (!p.caseId) return { ...p, tier: 'concept' as Tier, label: null, href: p.href };
  const entry = work.find((w) => w.id === p.caseId);
  if (!entry) throw new Error(`What We Do: unknown case "${p.caseId}"`);
  const tier = caseTier(entry);
  return { ...p, tier, label: TIER_LABEL[tier], href: `/${entry.id}` };
}
const clusters = BUILD_CLUSTERS.map((c) => ({
  ...c,
  page: primary.find((s) => s.id === c.id),
  proof: (BUILD_PROOF[c.id] ?? []).map(resolve),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${SITE.url}/services#list`,
      name: 'What Artifact Digital does',
      itemListElement: BUILD_CLUSTERS.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        description: c.summary,
        url: `${SITE.url}${buildPath(c.id)}`,
      })),
    },
    orgNode,
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'How We Help', path: '/services' },
    ]),
  ],
};
---
<BaseLayout
  title="How We Help · Fix, Build or Figure It Out · Artifact Digital"
  description="Three ways to work with Artifact Digital: fix a digital experience holding the business back, build the software you need, or run a workshop to find the right thing to build."
  canonical="/services"
  bodyClass="case-page services-hub"
  jsonLd={jsonLd}
>
  <section class="case-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'How We Help' }]} />
      <span class="eyebrow reveal"><span class="eyebrow-dot"></span>How we help</span>
      <h1 class="case-title">
        <span class="reveal-line"><span>Three ways in.</span></span>
        <span class="reveal-line italic"><span>One senior team behind them.</span></span>
      </h1>
      <p class="case-lede reveal">
        Most people arrive with a situation rather than a spec: something isn't keeping up,
        something needs building, or something needs figuring out first. Start there — the
        disciplines underneath are listed below for anyone who wants the detail.
      </p>
      <div class="wwb-hero-actions reveal">
        <Button href={CTA.primary.href} label={CTA.primary.label} variant="primary" />
        <a class="home-more__link" href="/how-we-work">See how we work<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <!-- THE THREE DOORS -->
  <section class="section doors" aria-labelledby="hub-doors-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>How we help</span>
        <h2 class="section-heading reveal-line" id="hub-doors-heading"><span>Where do you need help?</span></h2>
      </header>
      <ul class="door-grid">
        {DOORS.map((d) => (
          <li class="reveal-card">
            <a class="door-card" href={d.href}>
              <span class="door-card__num" aria-hidden="true">{d.num}</span>
              <h3 class="door-card__title">{d.label}</h3>
              <p class="door-card__price">{d.priceRange}</p>
              <p class="door-card__body">{d.summary}</p>
              <span class="door-card__more" aria-hidden="true">{d.cta.label} →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="home-more reveal"><a class="home-more__link" href="/pricing">How pricing works<span aria-hidden="true"> →</span></a></p>
    </div>
  </section>

  <!-- THE FIVE -->
  <section class="section wwb-clusters pk-section--stone" aria-labelledby="wwb-clusters-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Services</span>
        <h2 class="section-heading reveal-line" id="wwb-clusters-heading"><span>What we actually make</span></h2>
      </header>

      <ol class="wwb-cluster-list">
        {clusters.map((c, i) => (
          <li class="wwb-cluster" id={c.id}>
            <div class="wwb-cluster__main reveal">
              <span class="wwb-cluster__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="wwb-cluster__title">
                {c.page ? <a href={buildPath(c.id)}>{c.label}</a> : c.label}
              </h3>
              <p class="wwb-cluster__summary">{c.summary}</p>
              <ul class="wwb-tags" aria-label={`Examples of ${c.label.toLowerCase()} work`}>
                {c.examples.map((e) => <li>{e}</li>)}
              </ul>
              {c.page && (
                <p class="wwb-cluster__link">
                  <a class="home-more__link" href={buildPath(c.id)}>
                    {c.page.data.title}<span class="sr-only"> — {c.label}</span><span aria-hidden="true"> →</span>
                  </a>
                </p>
              )}
            </div>
            <div class="wwb-cluster__proof reveal">
              <h4 class="wwb-proof__title">Evidence</h4>
              <ul class="wwb-proof">
                {c.proof.map((p) => (
                  <li class="wwb-proof__item">
                    {p.label && (
                      <span class={`tier-chip tier-chip--${p.tier}`}>{p.label}{p.status ? ` · ${p.status}` : ''}</span>
                    )}
                    <a class="wwb-proof__name" href={p.href}>{p.name}</a>
                    <p class="wwb-proof__detail">{p.detail}</p>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <p class="wwb-legend reveal">
        <strong>Built by Artifact</strong> is work this company designed and built.
        <strong> Our founder’s work</strong> and <strong>our team’s prior work</strong> were
        led at a previous agency, before Artifact existed, and their clients aren’t named.
      </p>
    </div>
  </section>

  <!-- GO DEEPER -->
  <section class="section wwb-practice" aria-labelledby="wwb-practice-heading">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Go deeper</span>
        <h2 class="section-heading reveal-line" id="wwb-practice-heading"><span>The expertise behind it</span></h2>
      </header>
      <p class="home-lede reveal">
        Under every project sits the same senior practice: strategy, research, design,
        engineering, accessibility and AI. These pages go into each one, for anyone who
        wants the detail before they get in touch.
      </p>
      <ul class="wwb-practice__list">
        {deeper.map((s) => (
          <li><a href={`/services/${s.id}`}>{s.data.navLabel}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PLAYBOOKS -->
  <section class="section services-hub__playbooks">
    <div class="container">
      <header class="section-head">
        <span class="section-tag reveal"><span class="tag-dot"></span>Playbooks</span>
        <h2 class="section-heading reveal-line"><span>How we think, written down</span></h2>
      </header>
      <p class="pb-section-lede reveal">
        Nothing here is something you buy. It’s how we work — the questions we ask, the
        checks we run, and the answers that make us tell you not to build something.
      </p>
      <div class="service-link-grid">
        {PLAYBOOKS.map((p) => (
          <a class="service-link-card reveal-card" href={playbookPath(p.slug)}>
            <h3>{p.navLabel}</h3>
            <p>{p.summary}</p>
            <span class="service-link-card__more">Read it →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure which one you need?"
    sub="That’s a normal place to start. Tell us what you’re trying to do and we’ll tell you honestly what it needs — including when it’s smaller than you thought."
  />
</BaseLayout>
