---
import { NAV, CTA, WHO_WE_HELP, WHY_ARTIFACT } from '../data/site';
import { BUILD_CLUSTERS, buildPath } from '../data/build';
import ArrowIcon from './ArrowIcon.astro';

// One panel, opened from What We Do: the five things people come here for,
// who we help, and why us. Everything deeper is reached from those pages, so
// the nav never becomes a directory of internal vocabulary.
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="page-header is-stuck" id="pageHeader">
  <div class="container navbar">
    <a class="brand" href="/" aria-label="Artifact Digital home">
      <picture>
        <source media="(max-width: 760px)" srcset="/brand_assets/A_Logo_Mobile3.png" />
        <img src="/brand_assets/A_Logo_DT3.png" alt="Artifact Digital" class="brand-logo" width="171" height="57" />
      </picture>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {NAV.map((item) =>
        item.mega ? (
          <div class="nav-item nav-item--has-menu">
            <a class="nav-item__link" href={item.href} aria-haspopup="true">
              <span>{item.label}</span><i class="nav-caret" aria-hidden="true"></i>
            </a>

            <div class="nav-mega">
              <div class="container nav-mega__inner">
                <div class="nav-mega__col">
                  <h2 class="nav-mega__title">What we do</h2>
                  <ul class="nav-mega__list nav-mega__list--rich">
                    {BUILD_CLUSTERS.map((c) => (
                      <li>
                        <a href={buildPath(c.id)}>
                          <span class="nav-mega__item-label">{c.label}</span>
                          <span class="nav-mega__item-sub">{c.summary}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {/* Kept on one line: a newline here becomes a text node that
                      Chrome counts as a flex item, offsetting the label. */}
                  <a class="nav-mega__all" href="/services"><span>Everything we do</span><span class="nav-mega__arrow" aria-hidden="true">→</span></a>
                </div>

                <div class="nav-mega__col">
                  <h2 class="nav-mega__title">Who we help</h2>
                  <ul class="nav-mega__list">
                    {WHO_WE_HELP.map((w) => (
                      <li><a href={w.href}>{w.label}</a></li>
                    ))}
                  </ul>
                  <h2 class="nav-mega__title nav-mega__title--spaced">Why Artifact</h2>
                  <ul class="nav-mega__list">
                    {WHY_ARTIFACT.map((w) => (
                      <li><a href={w.href}>{w.label}</a></li>
                    ))}
                  </ul>
                </div>

                <div class="nav-mega__col nav-mega__col--feature">
                  <a class="nav-mega__promo" href="/why-artifact#ai-without-the-slop">
                    <span class="nav-mega__promo-title">AI without the slop</span>
                    <span class="nav-mega__promo-sub">
                      AI made building faster. It didn't make good thinking automatic. How we
                      use it, and where experience still decides.
                    </span>
                    <span class="nav-mega__promo-cta"><span>Read our position</span><span class="nav-mega__arrow" aria-hidden="true">→</span></span>
                  </a>
                  <a class="nav-mega__all" href="/work"><span>See our work</span><span class="nav-mega__arrow" aria-hidden="true">→</span></a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href}><span>{item.label}</span></a>
        )
      )}
    </nav>
    <a class="nav-cta" href={CTA.primary.href}>
      {CTA.primary.label}
      <ArrowIcon />
    </a>
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileNav"
    >
      <span class="nav-toggle__box" aria-hidden="true">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobileNav" aria-hidden="true">
  <nav class="mobile-nav__inner" aria-label="Mobile">
    {NAV.map((item) =>
      item.children ? (
        <div class="mobile-nav__group">
          <a class="mobile-nav__link mobile-nav__link--parent" href={item.href}>{item.label}</a>
          <ul class="mobile-nav__sub">
            {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
          </ul>
        </div>
      ) : (
        <a class="mobile-nav__link" href={item.href}>{item.label}</a>
      )
    )}
    <a class="mobile-nav__cta btn btn-primary" href={CTA.primary.href}>{CTA.primary.label}</a>
  </nav>
</div>
