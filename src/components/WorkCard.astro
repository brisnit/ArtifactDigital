---
import type { CollectionEntry } from 'astro:content';
import { responsive } from '../lib/responsive';
import { caseTier, tierText } from '../lib/proof';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Heading level so each page keeps a sane document outline. Capabilities
   *  nests cards under a group label, so it needs h4. */
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** First card in a grid is the LCP element — load it eagerly, never lazily. */
  priority?: boolean;
  /** Label the card with its proof tier and status (Built by Artifact · Live…). */
  showTier?: boolean;
  /** Full-width card. Overrides the case's own setting, so one page can lead
   *  with a case without changing how every other page lays it out. */
  wide?: boolean;
  /** Lead with the business problem this case solved, not the project name. */
  showProblem?: boolean;
}
const { entry, headingLevel = 'h3', priority = false, showTier = false, wide, showProblem = false } = Astro.props;
const tier = showTier ? caseTier(entry) : null;
const d = entry.data;
const Heading = headingLevel;
const card = await responsive(d.card.image);
// A wide lead card shows the product itself on desktop (the case's 21:9 feature
// shot), and falls back to the card art where it shares a row with other cards.
const isLead = wide === true && Boolean(d.feature?.image);
const lead = isLead ? await responsive(d.feature!.image) : null;

// Until real art exists, show a branded initial mark rather than a broken frame.
const mark = d.title
  .replace(/[^A-Za-z\s]/g, '')
  .split(/\s+/)
  .filter(Boolean)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
<a class="project-card-link" href={`/${entry.id}`} aria-label={`Read the ${d.title} case study`}>
  <article class:list={['project-card', 'reveal-card', (wide ?? d.card.wide) && 'project-card--wide', isLead && 'project-card--lead']}>
    <div
      class:list={[
        'project-card__media',
        d.card.image ? 'project-card__media--contain' : 'project-card__media--blank',
      ]}
      style="--media-bg: #f4f4f4;"
    >
      {d.card.image ? (
        <picture>
          {lead && (
            <source
              media="(min-width: 961px)"
              srcset={lead.srcset ?? d.feature!.image}
              sizes="(max-width: 1440px) 100vw, 1280px"
              width={lead.width}
              height={lead.height}
            />
          )}
          <img
            src={d.card.image}
            alt={isLead ? d.feature!.alt : d.card.imageAlt ?? ''}
            width={card.width}
            height={card.height}
            srcset={card.srcset}
            sizes="(max-width: 560px) 100vw, (max-width: 960px) 50vw, 400px"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
          />
        </picture>
      ) : (
        <span class="project-card__mark" aria-hidden="true">{mark}</span>
      )}
      <span class="project-card__hover">View case →</span>
    </div>
    <div class="project-card__meta">
      <span>{d.card.eyebrow}</span>
      <span>{d.year}</span>
    </div>
    {tier && <span class={`tier-chip tier-chip--${tier} project-card__tier`}>{tierText(entry)}</span>}
    {showProblem && d.problem ? (
      <>
        <Heading class="project-card__title">{d.problem}</Heading>
        <p class="project-card__copy"><span class="project-card__client">{d.title}</span> {d.card.blurb}</p>
      </>
    ) : (
      <>
        <Heading class="project-card__title">{d.title}</Heading>
        <p class="project-card__copy">{d.card.blurb}</p>
      </>
    )}
    <ul class="project-card__tags">{d.card.tags.map((t) => <li>{t}</li>)}</ul>
  </article>
</a>
